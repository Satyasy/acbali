---
import { siteConfig, faqs } from '../config/site';
import { translations } from '../config/i18n';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = `${siteConfig.name} - Jasa Servis & Cuci AC Panggilan Cepat di Bali (24 Jam Non-Stop)`,
  description = siteConfig.description,
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site || 'https://jawarateknikac.com').href;

// 1. JSON-LD HVAC / Local Business Structured Data
const businessSchema = {
  "@context": "https://schema.org",
  "@type": ["LocalBusiness", "HVACBusiness"],
  "@id": "https://jawarateknikac.com/#business",
  "name": siteConfig.legalName,
  "alternateName": siteConfig.name,
  "description": siteConfig.description,
  "url": "https://jawarateknikac.com",
  "logo": "https://jawarateknikac.com/icon-512.png",
  "image": "https://jawarateknikac.com/icon-512.png",
  "hasMap": siteConfig.mapsDirectUrl,
  "sameAs": [
    siteConfig.mapsDirectUrl,
    siteConfig.mapsSearchUrl
  ],
  "telephone": siteConfig.phone,
  "priceRange": "$$",
  "paymentAccepted": ["Cash", "QRIS", "Bank Transfer"],
  "currenciesAccepted": "IDR",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": siteConfig.address.street,
    "addressLocality": siteConfig.address.subDistrict,
    "addressRegion": siteConfig.address.province,
    "postalCode": siteConfig.address.postalCode,
    "addressCountry": "ID"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": siteConfig.address.geo.latitude,
    "longitude": siteConfig.address.geo.longitude
  },
  "openingHoursSpecification": [
    {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": [
        "Monday",
        "Tuesday",
        "Wednesday",
        "Thursday",
        "Friday",
        "Saturday",
        "Sunday"
      ],
      "opens": "00:00",
      "closes": "23:59"
    }
  ],
  "areaServed": [
    { "@type": "City", "name": "Denpasar" },
    { "@type": "AdministrativeArea", "name": "Badung" },
    { "@type": "Place", "name": "Canggu" },
    { "@type": "Place", "name": "Seminyak" },
    { "@type": "Place", "name": "Sanur" },
    { "@type": "Place", "name": "Kuta" },
    { "@type": "Place", "name": "Jimbaran" },
    { "@type": "Place", "name": "Ubud" },
    { "@type": "AdministrativeArea", "name": "Gianyar" },
    { "@type": "AdministrativeArea", "name": "Tabanan" }
  ],
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Layanan Servis & Cuci AC Bali",
    "itemListElement": [
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": "Cuci AC Standar (0.5 – 1 PK)",
          "description": "Cuci filter, cover indoor, talang air, evaporator steam, dan pembersihan kisi-kisi kondensor outdoor."
        }
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": "Cuci Unit AC Inverter Khusus",
          "description": "Perawatan khusus modul PCB elektrikal sensitif dan chemical wash aman sensor."
        }
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": "Tambah / Isi Freon R32 & R410a",
          "description": "Pengisian freon ramah lingkungan tipe R32 atau R410a murni bergaransi."
        }
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": "Perbaikan AC Bocor / Menetes Air",
          "description": "Pembersihan lendir lumut saluran drainase dan perbaikan kondensasi dinding."
        }
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": "Bongkar Pasang & Relokasi AC",
          "description": "Layanan pemindahan, bongkar pasang unit AC rumah, villa, kos, dan gedung kantor di Bali."
        }
      }
    ]
  }
};

// 2. Google Search Sitelinks & WebSite Schema
const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": "https://jawarateknikac.com/#website",
  "url": "https://jawarateknikac.com",
  "name": "Jawara Teknik AC Bali",
  "alternateName": [
    "Jawara Teknik",
    "Jawara Teknik AC",
    "Jawara Teknik Servis AC Bali",
    "jawara teknik ac bali"
  ],
  "description": siteConfig.description,
  "inLanguage": "id-ID",
  "publisher": {
    "@id": "https://jawarateknikac.com/#business"
  }
};

// 3. Google Search Sitelinks Navigation Elements Schema
const sitelinksSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "itemListElement": [
    {
      "@type": "SiteNavigationElement",
      "position": 1,
      "name": "Katalog Layanan & Konsultasi Servis AC",
      "description": "Konsultasi estimasi tarif cuci AC split, inverter, tambah freon, dan perbaikan bergaransi di Bali",
      "url": "https://jawarateknikac.com/#tarif"
    },
    {
      "@type": "SiteNavigationElement",
      "position": 2,
      "name": "Solusi Kendala AC Populer di Bali",
      "description": "Diagnosa penanganan teknisi untuk AC bocor menetes air, AC kurang dingin, bau apek, dan kompresor berisik",
      "url": "https://jawarateknikac.com/#masalah"
    },
    {
      "@type": "SiteNavigationElement",
      "position": 3,
      "name": "Paket Perawatan Rutin Villa & B2B Bali",
      "description": "Kontrak pemeliharaan berkala AC untuk villa, resort, kafe, dan perkantoran dengan invoice resmi",
      "url": "https://jawarateknikac.com/#paket-villa"
    },
    {
      "@type": "SiteNavigationElement",
      "position": 4,
      "name": "Area Jangkauan Pos Armada Siaga Bali",
      "description": "Posko teknisi darurat 60 menit Denpasar, Badung, Canggu, Seminyak, Kuta, Sanur, Ubud, Gianyar, Tabanan",
      "url": "https://jawarateknikac.com/#wilayah"
    },
    {
      "@type": "SiteNavigationElement",
      "position": 5,
      "name": "Alur 3 Langkah Pemesanan WhatsApp",
      "description": "Tata cara mudah panggil teknisi via WhatsApp tanpa antre dan respon kilat 60 menit",
      "url": "https://jawarateknikac.com/#cara-order"
    },
    {
      "@type": "SiteNavigationElement",
      "position": 6,
      "name": "Tanya Jawab & Garansi 30 Hari (FAQ)",
      "description": "Informasi garansi pengerjaan 30 hari penuh, waktu kedatangan teknisi, dan konsultasi gratis",
      "url": "https://jawarateknikac.com/#faq"
    }
  ]
};

// 4. FAQ Schema for Google Rich Results
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(item => ({
    "@type": "Question",
    "name": item.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": item.answer
    }
  }))
};
---

<!doctype html>
<html lang="id" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
    <meta name="theme-color" content="#0F4C81" />
    
    <!-- Google Site Verification (Google Search Console) -->
    <meta name="google-site-verification" content="uDrM6u-zFukD37FuPbfiypBUpLcVqeFmUYAAmAFFMlE" />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <meta name="author" content="Jawara Teknik Servis AC Bali" />
    <meta name="keywords" content="servis ac denpasar, cuci ac bali, service ac badung, cuci ac canggu, servis ac seminyak, perbaikan ac sanur, isi freon ac bali, bengkel ac panggilan bali, teknisi ac 24 jam bali, ac inverter bali" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="sitemap" href="/sitemap.xml" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={siteConfig.heroImage} />
    <meta property="og:locale" content="id_ID" />
    <meta property="og:site_name" content={siteConfig.legalName} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalUrl} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={siteConfig.heroImage} />

    <!-- Performance: Preload Critical Hero Image & Preconnect Fonts & Images -->
    <link rel="preconnect" href="https://images.unsplash.com" crossorigin />
    <link rel="dns-prefetch" href="https://images.unsplash.com" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" as="image" href={siteConfig.heroImage} fetchpriority="high" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" />

    <!-- Favicon & App Icons (Google Search Snippet & Modern Browser Compliant) -->
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48x48.png" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- Schema.org Structured Data (HVAC, WebSite Sitelinks, FAQ) -->
    <script type="application/ld+json" set:html={JSON.stringify(businessSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(sitelinksSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  </head>
  <body class="bg-slatewhite text-slate-900 selection:bg-iceblue-600 selection:text-white min-h-screen flex flex-col font-sans">
    <slot />

    <!-- Client-side Lightweight i18n Engine (Zero Lag, 100 Lighthouse) -->
    <script is:inline define:vars={{ translationsData: translations }}>
      (function() {
        const defaultLang = 'id';
        function getSavedLang() {
          try {
            return localStorage.getItem('jawara_lang') || defaultLang;
          } catch (e) {
            return defaultLang;
          }
        }

        function resolveValue(obj, path) {
          if (!obj || !path) return null;
          const parts = path.split('.');
          let curr = obj;
          for (const part of parts) {
            if (curr && typeof curr === 'object' && part in curr) {
              curr = curr[part];
            } else {
              return null;
            }
          }
          return typeof curr === 'string' ? curr : null;
        }

        function applyLanguage(lang, isManual = false) {
          const dict = translationsData[lang] || translationsData.id;
          if (!dict) return;

          try {
            localStorage.setItem('jawara_lang', lang);
          } catch (e) {}

          document.documentElement.lang = lang;

          // Seamless 150ms iOS-style crossfade ONLY on manual user clicks
          if (isManual) {
            document.body.classList.add('lang-crossfade');
            setTimeout(() => {
              document.body.classList.remove('lang-crossfade');
            }, 150);
          }

          // Update text nodes
          const elements = document.querySelectorAll('[data-i18n]');
          elements.forEach((el) => {
            const path = el.getAttribute('data-i18n');
            const val = resolveValue(dict, path);
            if (val !== null) {
              el.textContent = val;
            }
          });

          // Update input placeholders
          const phElements = document.querySelectorAll('[data-i18n-ph]');
          phElements.forEach((el) => {
            const path = el.getAttribute('data-i18n-ph');
            const val = resolveValue(dict, path);
            if (val !== null) {
              el.setAttribute('placeholder', val);
            }
          });

          // iOS Sliding Glass Thumb & Micro-Zoom
          const thumb = document.getElementById('lang-glass-thumb');
          if (thumb) {
            const isEn = lang === 'en';
            if (isManual) {
              thumb.style.transform = isEn ? 'translateX(100%) scale(1.06)' : 'translateX(0) scale(1.06)';
              setTimeout(() => {
                thumb.style.transform = isEn ? 'translateX(100%) scale(1)' : 'translateX(0) scale(1)';
              }, 180);
            } else {
              thumb.style.transform = isEn ? 'translateX(100%) scale(1)' : 'translateX(0) scale(1)';
            }
          }

          // Update language toggle buttons visual state
          const langBtns = document.querySelectorAll('[data-lang-btn]');
          langBtns.forEach((btn) => {
            const btnLang = btn.getAttribute('data-lang-btn');
            if (btnLang === lang) {
              btn.className = 'lang-btn relative z-10 w-8 sm:w-9 text-center py-1 text-xs font-black transition-colors duration-200 cursor-pointer text-navy-950';
            } else {
              btn.className = 'lang-btn relative z-10 w-8 sm:w-9 text-center py-1 text-xs font-medium transition-colors duration-200 cursor-pointer text-slate-500 hover:text-navy-950';
            }
          });

          window.dispatchEvent(new CustomEvent('languageChanged', { detail: { lang } }));
        }

        // Run on DOM ready or immediately if already loaded (without initial animation)
        const initialLang = getSavedLang();
        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', () => applyLanguage(initialLang, false));
        } else {
          applyLanguage(initialLang, false);
        }

        // Delegate language switch clicks (trigger smooth transition)
        document.addEventListener('click', (e) => {
          const btn = e.target.closest('[data-lang-btn]');
          if (btn) {
            e.preventDefault();
            const targetLang = btn.getAttribute('data-lang-btn');
            if (targetLang) applyLanguage(targetLang, true);
          }
        });
      })();
    </script>

    <!-- Lightweight Apple-Style Smooth Scroll Reveal Observer (Zero Lag, 100 Lighthouse) -->
    <script is:inline>
      (function() {
        if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          document.querySelectorAll('.reveal-on-scroll').forEach(el => el.classList.add('is-revealed'));
          return;
        }

        const observer = new IntersectionObserver((entries, obs) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              const el = entry.target;
              const delay = el.getAttribute('data-reveal-delay');
              if (delay) {
                setTimeout(() => {
                  el.classList.add('is-revealed');
                }, parseInt(delay, 10));
              } else {
                el.classList.add('is-revealed');
              }
              obs.unobserve(el);
            }
          });
        }, {
          rootMargin: '0px 0px -40px 0px',
          threshold: 0.08,
        });

        function observeElements() {
          document.querySelectorAll('.reveal-on-scroll:not(.is-revealed)').forEach(el => observer.observe(el));
        }

        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', observeElements);
        } else {
          observeElements();
        }
      })();
    </script>
  </body>
</html>
