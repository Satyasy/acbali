---
import { siteConfig, faqs } from '../config/site';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = `${siteConfig.name} - Jasa Servis & Cuci AC Panggilan Cepat di Bali (06.00 – 23.00 WITA)`,
  description = siteConfig.description,
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site || 'https://jawara-teknik.com').href;

// 1. JSON-LD HVAC / Local Business Structured Data
const businessSchema = {
  "@context": "https://schema.org",
  "@type": ["LocalBusiness", "HVACBusiness"],
  "@id": "https://jawara-teknik.com/#business",
  "name": siteConfig.legalName,
  "alternateName": siteConfig.name,
  "description": siteConfig.description,
  "url": "https://jawara-teknik.com",
  "hasMap": siteConfig.mapsDirectUrl,
  "sameAs": [
    siteConfig.mapsDirectUrl,
    siteConfig.mapsSearchUrl
  ],
  "telephone": siteConfig.phone,
  "priceRange": "Rp 60.000 - Rp 375.000",
  "paymentAccepted": ["Cash", "QRIS", "Bank Transfer"],
  "currenciesAccepted": "IDR",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": siteConfig.address.street,
    "addressLocality": siteConfig.address.subDistrict,
    "addressRegion": siteConfig.address.province,
    "postalCode": siteConfig.address.postalCode,
    "addressCountry": "ID"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": siteConfig.address.geo.latitude,
    "longitude": siteConfig.address.geo.longitude
  },
  "openingHoursSpecification": [
    {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": [
        "Monday",
        "Tuesday",
        "Wednesday",
        "Thursday",
        "Friday",
        "Saturday",
        "Sunday"
      ],
      "opens": "06:00",
      "closes": "23:00"
    }
  ],
  "areaServed": [
    { "@type": "City", "name": "Denpasar" },
    { "@type": "AdministrativeArea", "name": "Badung" },
    { "@type": "Place", "name": "Canggu" },
    { "@type": "Place", "name": "Seminyak" },
    { "@type": "Place", "name": "Sanur" },
    { "@type": "Place", "name": "Kuta" },
    { "@type": "Place", "name": "Jimbaran" },
    { "@type": "Place", "name": "Ubud" },
    { "@type": "AdministrativeArea", "name": "Gianyar" },
    { "@type": "AdministrativeArea", "name": "Tabanan" }
  ],
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Layanan Servis & Cuci AC Bali",
    "itemListElement": [
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": "Cuci AC Standar (0.5 – 1 PK)",
          "description": "Cuci filter, cover indoor, talang air, evaporator steam, dan pembersihan kisi-kisi kondensor outdoor."
        },
        "price": "75000",
        "priceCurrency": "IDR"
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": "Cuci Unit AC Inverter",
          "description": "Perawatan khusus modul PCB elektrikal sensitif dan chemical wash aman sensor."
        },
        "price": "100000",
        "priceCurrency": "IDR"
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": "Tambah Freon R32 / R410a",
          "description": "Pengisian freon ramah lingkungan tipe R32 atau R410a hingga tekanan standar."
        },
        "price": "200000",
        "priceCurrency": "IDR"
      }
    ]
  }
};

// 2. Google Search Sitelinks & WebSite Schema
const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": "https://jawara-teknik.com/#website",
  "url": "https://jawara-teknik.com",
  "name": "Jawara Teknik - Servis AC Panggilan Bali",
  "alternateName": "Jawara Teknik Bali",
  "description": siteConfig.description,
  "inLanguage": "id-ID"
};

// 3. Google Search Sitelinks Navigation Elements Schema
const sitelinksSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "itemListElement": [
    {
      "@type": "SiteNavigationElement",
      "position": 1,
      "name": "Daftar Tarif Servis AC",
      "description": "Harga pasti transparan cuci AC standar, inverter, tambah freon, dan bongkar pasang di Bali",
      "url": "https://jawara-teknik.com/#tarif"
    },
    {
      "@type": "SiteNavigationElement",
      "position": 2,
      "name": "Solusi Keluhan & Kerusakan AC",
      "description": "Diagnosa penanganan AC tidak dingin, bocor air menetes, bau apek, dan suara bising",
      "url": "https://jawara-teknik.com/#masalah"
    },
    {
      "@type": "SiteNavigationElement",
      "position": 3,
      "name": "Paket Rutin Villa & B2B Bali",
      "description": "Kontrak pemeliharaan berkala AC untuk villa, resort, kafe, dan perkantoran dengan invoice resmi",
      "url": "https://jawara-teknik.com/#paket-villa"
    },
    {
      "@type": "SiteNavigationElement",
      "position": 4,
      "name": "Cakupan Wilayah Siaga Bali",
      "description": "Area pos teknisi panggilan Denpasar, Badung, Canggu, Seminyak, Kuta, Sanur, Ubud, Gianyar, Tabanan",
      "url": "https://jawara-teknik.com/#wilayah"
    },
    {
      "@type": "SiteNavigationElement",
      "position": 5,
      "name": "Alur 3 Langkah Pemesanan",
      "description": "Tata cara mudah panggil teknisi via WhatsApp tanpa antre dan respon kilat 60 menit",
      "url": "https://jawara-teknik.com/#cara-order"
    },
    {
      "@type": "SiteNavigationElement",
      "position": 6,
      "name": "Tanya Jawab (FAQ)",
      "description": "Pertanyaan seputar garansi 30 hari, estimasi durasi servis, dan kesiapan teknisi hari libur",
      "url": "https://jawara-teknik.com/#faq"
    }
  ]
};

// 4. FAQ Schema for Google Rich Results
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(item => ({
    "@type": "Question",
    "name": item.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": item.answer
    }
  }))
};
---

<!doctype html>
<html lang="id" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
    <meta name="theme-color" content="#0F4C81" />
    
    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <meta name="author" content="Jawara Teknik Servis AC Bali" />
    <meta name="keywords" content="servis ac denpasar, cuci ac bali, service ac badung, cuci ac canggu, servis ac seminyak, perbaikan ac sanur, isi freon ac bali, bengkel ac panggilan bali, teknisi ac 24 jam bali, ac inverter bali" />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={siteConfig.heroImage} />
    <meta property="og:locale" content="id_ID" />
    <meta property="og:site_name" content={siteConfig.legalName} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalUrl} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={siteConfig.heroImage} />

    <!-- Performance: Preload Critical Hero Image & Preconnect Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" as="image" href={siteConfig.heroImage} fetchpriority="high" />
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" media="print" onload="this.media='all'" />
    <noscript>
      <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" />
    </noscript>

    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%230F4C81' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><line x1='2' x2='22' y1='12' y2='12'/><line x1='12' x2='12' y1='2' y2='22'/><path d='m20 16-4-4 4-4'/><path d='m4 8 4 4-4 4'/><path d='m16 4-4 4-4-4'/><path d='m8 20 4-4 4 4'/></svg>" />

    <!-- Schema.org Structured Data (HVAC, WebSite Sitelinks, FAQ) -->
    <script type="application/ld+json" set:html={JSON.stringify(businessSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(sitelinksSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  </head>
  <body class="bg-slatewhite text-slate-900 selection:bg-iceblue-600 selection:text-white min-h-screen flex flex-col font-sans pb-20 lg:pb-0">
    <slot />
  </body>
</html>
