---
import { siteConfig, createWhatsAppLink } from '../config/site';

const primaryWaUrl = createWhatsAppLink({
  service: "Panggilan Cepat (Cuci / Perbaikan AC)",
  notes: "Halo Jawara Teknik, saya butuh bantuan teknisi AC untuk hari ini di Bali.",
});

const heroSlides = [
  { src: "/images/hero-1.webp", alt: "Teknisi profesional AC Jawara Teknik Bali" },
  { src: "/images/hero-2.webp", alt: "Layanan servis dan cuci AC Denpasar Badung" },
  { src: "/images/hero-3.webp", alt: "Perbaikan kompresor dan freon AC Bali" },
  { src: "/images/hero-4.webp", alt: "Pengecekan dan instalasi AC rumah villa kantor Bali" },
];

const heroSnowflakes = [
  { left: 8, duration: 11, delay: 0, size: 11, opacity: 0.35, char: "❄" },
  { left: 22, duration: 14, delay: 3, size: 14, opacity: 0.4, char: "❅" },
  { left: 36, duration: 9.5, delay: 1.5, size: 9, opacity: 0.3, char: "❄" },
  { left: 52, duration: 13, delay: 4.5, size: 12, opacity: 0.45, char: "❆" },
  { left: 66, duration: 10.5, delay: 2, size: 10, opacity: 0.32, char: "❄" },
  { left: 80, duration: 15, delay: 5.5, size: 13, opacity: 0.38, char: "❅" },
  { left: 92, duration: 12, delay: 1, size: 11, opacity: 0.35, char: "❄" },
];
---

<section id="hero" class="relative min-h-[calc(100vh-3rem)] min-h-[calc(100svh-3rem)] sm:min-h-[640px] lg:min-h-[700px] flex flex-col justify-between pt-5 pb-4 sm:pt-20 sm:pb-16 lg:pt-22 lg:pb-20 overflow-hidden bg-slate-950">
  
  <!-- Hero Background Carousel with Smooth Cinematic Crossfade -->
  <div class="absolute inset-0 z-0 overflow-hidden" id="hero-carousel" aria-hidden="true">
    {heroSlides.map((slide, index) => (
      <img
        src={slide.src}
        alt={slide.alt}
        class={`hero-slide absolute inset-0 w-full h-full object-cover object-center transition-opacity duration-1000 ease-in-out ${index === 0 ? 'opacity-85 z-[2]' : 'opacity-0 z-[1]'}`}
        loading={index === 0 ? "eager" : "lazy"}
        decoding="async"
        fetchpriority={index === 0 ? "high" : "low"}
        width="1200"
        height="800"
      />
    ))}
    <!-- Softened dark overlay for vivid, bright photos while maintaining crisp text contrast -->
    <div class="absolute inset-0 bg-gradient-to-t from-slate-950/80 via-slate-950/40 to-slate-950/20 z-[3]"></div>

    <!-- Branded Logo Silhouette Watermark (Bottom-Right Anchor for Clean Asymmetric Identity) -->
    <div class="absolute -bottom-10 -right-10 sm:-bottom-16 sm:-right-16 lg:-bottom-20 lg:-right-20 z-[4] pointer-events-none select-none overflow-hidden" aria-hidden="true">
      <img
        src="/images/logo-white.webp"
        alt=""
        class="w-64 h-64 sm:w-80 sm:h-80 lg:w-[480px] lg:h-[480px] object-contain opacity-20 mix-blend-screen transform -rotate-12 filter drop-shadow-2xl"
        loading="eager"
        decoding="async"
        width="480"
        height="480"
      />
    </div>
  </div>

  <!-- Ambient Cold Breeze & Delicate Snowflakes Particle Atmosphere -->
  <div class="absolute inset-0 z-[5] pointer-events-none select-none overflow-hidden" aria-hidden="true">
    <div class="hero-breeze hero-breeze-1"></div>
    <div class="hero-breeze hero-breeze-2"></div>
    <div class="hero-breeze hero-breeze-3"></div>
    {heroSnowflakes.map((flake) => (
      <span
        class="hero-snowflake"
        style={`left: ${flake.left}%; animation-duration: ${flake.duration}s; animation-delay: ${flake.delay}s; font-size: ${flake.size}px; opacity: ${flake.opacity};`}
      >
        {flake.char}
      </span>
    ))}
  </div>

  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full flex-1 flex flex-col justify-between">
    
    <!-- Top & Middle Focal Content (Badge, Headline, Subheadline, CTA) -->
    <div class="max-w-4xl mx-auto text-center flex-1 flex flex-col justify-center my-auto pt-2 sm:pt-0">
      
      <!-- Top Pill Indicator (Apple Frosted Glass) with comfortable margin from sticky navbar -->
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full glass-apple-pill text-slate-100 text-xs font-semibold mb-3.5 sm:mb-5 shadow-xs mx-auto">
        <!-- Lucide MapPin -->
        <svg class="w-3.5 h-3.5 text-iceblue-300 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"></path>
          <circle cx="12" cy="10" r="3"></circle>
        </svg>
        <span data-i18n="topbar.badge1">Siaga 24 Jam Non-Stop</span>
        <span class="text-slate-400">•</span>
        <span class="text-iceblue-200" data-i18n="topbar.badge2">Respon Tiba 60 Menit</span>
      </div>

      <!-- Main H1 Headline: Pulled down with generous breathing room -->
      <h1 class="text-2xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-tight leading-[1.2] mb-3 sm:mb-5">
        <span data-i18n="hero.title_1">Servis & Cuci AC Panggilan Cepat</span> <span data-i18n="hero.in">di</span> <span class="text-iceblue-400">Denpasar, Badung</span>, <span data-i18n="hero.title_2">dan Sekitarnya</span>
      </h1>

      <!-- Sub-headline: Punchy on mobile, comprehensive on tablet/desktop -->
      <p class="text-sm sm:text-base text-slate-100 font-normal leading-relaxed mb-5 sm:mb-8 max-w-2xl mx-auto">
        <span data-i18n="hero.desc_lead">Spesialis pendingin udara panggilan cepat di Bali.</span><span class="hidden sm:inline" data-i18n="hero.desc_detail"> Teknisi ahli berpengalaman siap menuju rumah, villa, kos, dan kantor Anda dengan tarif transparan dan garansi 30 hari penuh.</span>
      </p>

      <!-- Primary & Secondary CTA Buttons -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-3 sm:gap-4 mb-4 sm:mb-9">
        <!-- Primary WhatsApp CTA Button -->
        <a
          href={primaryWaUrl}
          target="_blank"
          rel="noopener noreferrer"
          data-open-modal
          data-service="Panggilan Cepat (Cuci / Perbaikan AC)"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2.5 btn-cta-whatsapp text-slate-950 font-bold text-sm sm:text-base px-6 py-3 sm:px-7 sm:py-3.5 rounded-xl shadow-lg cursor-pointer"
        >
          <!-- Official Lucide MessageCircle (100% Symmetrical) -->
          <svg class="w-5 h-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"></path>
          </svg>
          <span data-i18n="hero.btn_order">Pesan Teknisi Sekarang</span>
        </a>

        <!-- Secondary Pricing CTA Button (Apple Glass) -->
        <a
          href="#tarif"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 text-white font-bold text-sm sm:text-base px-6 py-3 sm:px-7 sm:py-3.5 rounded-xl glass-apple-pill shadow-xs"
        >
          <!-- Official Lucide Banknote -->
          <svg class="w-5 h-5 shrink-0 text-iceblue-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect width="20" height="12" x="2" y="6" rx="2"></rect>
            <circle cx="12" cy="12" r="2"></circle>
            <path d="M6 12h.01M18 12h.01"></path>
          </svg>
          <span data-i18n="hero.btn_pricing">Lihat Daftar Tarif</span>
        </a>
      </div>

    </div>

    <!-- Bottom Anchor Bar (Unified Single Horizontal Ultra-Translucent Frosted Glass Card) -->
    <div class="w-full mt-auto pt-2 sm:pt-6">
      <div class="bg-white/[0.07] backdrop-blur-md border border-white/15 shadow-sm rounded-2xl p-2 sm:p-3.5 max-w-4xl mx-auto">
        <div class="grid grid-cols-3 divide-x divide-white/10 items-center">
          
          <!-- Trust Badge 1: Garansi 30 Hari -->
          <div class="px-1.5 sm:px-4 py-1.5 flex flex-col sm:flex-row items-center sm:items-start gap-1 sm:gap-3.5 text-center sm:text-left">
            <div class="w-6 h-6 sm:w-10 sm:h-10 rounded-lg sm:rounded-xl bg-iceblue-500/20 text-iceblue-300 border border-iceblue-300/30 flex items-center justify-center shrink-0 shadow-inner">
              <!-- Official Lucide ShieldCheck -->
              <svg class="w-3.5 h-3.5 sm:w-5 sm:h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                <path d="m9 12 2 2 4-4"></path>
              </svg>
            </div>
            <div class="min-w-0">
              <h2 class="font-bold text-white text-[11px] sm:text-sm leading-tight">
                <span class="sm:hidden" data-i18n="hero.trust1_short">Garansi 30 Hari</span>
                <span class="hidden sm:inline" data-i18n="hero.trust1_title">Garansi 30 Hari Penuh</span>
              </h2>
              <p class="hidden sm:block text-xs text-slate-200 mt-0.5" data-i18n="hero.trust1_desc">Klaim mudah jika kendala kembali muncul.</p>
            </div>
          </div>

          <!-- Trust Badge 2: Multi-Merek -->
          <div class="px-1.5 sm:px-4 py-1.5 flex flex-col sm:flex-row items-center sm:items-start gap-1 sm:gap-3.5 text-center sm:text-left">
            <div class="w-6 h-6 sm:w-10 sm:h-10 rounded-lg sm:rounded-xl bg-navy-500/30 text-iceblue-300 border border-navy-300/30 flex items-center justify-center shrink-0 shadow-inner">
              <!-- Official Lucide Wrench -->
              <svg class="w-3.5 h-3.5 sm:w-5 sm:h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"></path>
              </svg>
            </div>
            <div class="min-w-0">
              <h2 class="font-bold text-white text-[11px] sm:text-sm leading-tight">
                <span class="sm:hidden" data-i18n="hero.trust2_short">Multi-Brand Ahli</span>
                <span class="hidden sm:inline" data-i18n="hero.trust2_title">Teknisi Multi-Merek</span>
              </h2>
              <p class="hidden sm:block text-xs text-slate-200 mt-0.5" data-i18n="hero.trust2_desc">Daikin, Panasonic, Sharp, Gree, LG.</p>
            </div>
          </div>

          <!-- Trust Badge 3: Tanpa Biaya Tersembunyi -->
          <div class="px-1.5 sm:px-4 py-1.5 flex flex-col sm:flex-row items-center sm:items-start gap-1 sm:gap-3.5 text-center sm:text-left">
            <div class="w-6 h-6 sm:w-10 sm:h-10 rounded-lg sm:rounded-xl bg-emerald-500/20 text-emerald-300 border border-emerald-300/30 flex items-center justify-center shrink-0 shadow-inner">
              <!-- Official Lucide CheckCircle2 -->
              <svg class="w-3.5 h-3.5 sm:w-5 sm:h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"></circle>
                <path d="m9 12 2 2 4-4"></path>
              </svg>
            </div>
            <div class="min-w-0">
              <h2 class="font-bold text-white text-[11px] sm:text-sm leading-tight">
                <span class="sm:hidden" data-i18n="hero.trust3_short">Tarif Transparan</span>
                <span class="hidden sm:inline" data-i18n="hero.trust3_title">Tanpa Biaya Tersembunyi</span>
              </h2>
              <p class="hidden sm:block text-xs text-slate-200 mt-0.5" data-i18n="hero.trust3_desc">Tarif transparan disetujui di awal.</p>
            </div>
          </div>

        </div>
      </div>
    </div>
  </div>
</section>

<script>
  function initHeroCarousel() {
    const slides = document.querySelectorAll<HTMLImageElement>('.hero-slide');
    if (slides.length <= 1) return;
    let currentIndex = 0;
    setInterval(() => {
      const prevIndex = currentIndex;
      currentIndex = (currentIndex + 1) % slides.length;

      slides.forEach((slide, idx) => {
        if (idx === currentIndex) {
          slide.classList.remove('opacity-0', 'z-[1]');
          slide.classList.add('opacity-85', 'z-[2]');
        } else if (idx === prevIndex) {
          slide.classList.remove('opacity-85', 'z-[2]');
          slide.classList.add('opacity-0', 'z-[1]');
        } else {
          slide.classList.remove('opacity-85', 'z-[2]');
          slide.classList.add('opacity-0', 'z-[0]');
        }
      });
    }, 4500);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initHeroCarousel);
  } else {
    initHeroCarousel();
  }
</script>

<style>
  /* Lock GPU rendering and compositing layer to eliminate mobile scroll zoom-in/out */
  #hero {
    contain: paint;
  }

  .hero-slide {
    transform: translateZ(0);
    -webkit-transform: translateZ(0);
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
  }

  /* Hardware-accelerated gentle snowflake drift */
  @keyframes snowfallDrift {
    0% {
      transform: translate3d(0, -30px, 0) rotate(0deg);
    }
    50% {
      transform: translate3d(20px, 45vh, 0) rotate(180deg);
    }
    100% {
      transform: translate3d(-15px, 105vh, 0) rotate(360deg);
    }
  }

  .hero-snowflake {
    position: absolute;
    top: -30px;
    color: #BAE6FD;
    text-shadow: 0 0 8px rgba(56, 189, 248, 0.7);
    pointer-events: none;
    animation-name: snowfallDrift;
    animation-timing-function: linear;
    animation-iteration-count: infinite;
    will-change: transform;
  }

  /* Horizontal cool conditioned air breeze wisps */
  @keyframes heroBreezeFlow {
    0% {
      transform: translate3d(-120%, 0, 0);
      opacity: 0;
    }
    20% {
      opacity: 0.45;
    }
    80% {
      opacity: 0.45;
    }
    100% {
      transform: translate3d(220%, 0, 0);
      opacity: 0;
    }
  }

  .hero-breeze {
    position: absolute;
    height: 1.5px;
    border-radius: 9999px;
    background: linear-gradient(90deg, transparent, rgba(56, 189, 248, 0.4), rgba(255, 255, 255, 0.7), rgba(56, 189, 248, 0.4), transparent);
    filter: blur(1px);
    will-change: transform;
    animation: heroBreezeFlow ease-in-out infinite;
  }

  .hero-breeze-1 {
    top: 28%;
    width: 260px;
    animation-duration: 9s;
    animation-delay: 0s;
  }

  .hero-breeze-2 {
    top: 48%;
    width: 320px;
    animation-duration: 12s;
    animation-delay: 3.5s;
  }

  .hero-breeze-3 {
    top: 68%;
    width: 220px;
    animation-duration: 8.5s;
    animation-delay: 6s;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-snowflake,
    .hero-breeze {
      display: none !important;
    }
  }
</style>
