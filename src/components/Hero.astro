---
import { siteConfig, createWhatsAppLink } from '../config/site';

const primaryWaUrl = createWhatsAppLink({
  service: "Panggilan Cepat (Cuci / Perbaikan AC)",
  notes: "Halo Jawara Teknik, saya butuh bantuan teknisi AC untuk hari ini di Bali.",
});

const heroSlides = [
  { src: "/images/hero-1.webp", alt: "Teknisi profesional AC Jawara Teknik Bali" },
  { src: "/images/hero-2.webp", alt: "Layanan servis dan cuci AC Denpasar Badung" },
  { src: "/images/hero-3.webp", alt: "Perbaikan kompresor dan freon AC Bali" },
  { src: "/images/hero-4.webp", alt: "Pengecekan dan instalasi AC rumah villa kantor Bali" },
];
---

<section id="hero" class="relative min-h-[580px] sm:min-h-[640px] lg:min-h-[700px] flex items-center justify-center pt-16 pb-12 sm:pt-20 sm:pb-16 lg:pt-22 lg:pb-20 overflow-hidden bg-slate-950">
  
  <!-- Hero Background Carousel with Smooth Cinematic Crossfade -->
  <div class="absolute inset-0 z-0 overflow-hidden" id="hero-carousel" aria-hidden="true">
    {heroSlides.map((slide, index) => (
      <img
        src={slide.src}
        alt={slide.alt}
        class={`hero-slide absolute inset-0 w-full h-full object-cover object-center transition-opacity duration-1000 ease-in-out ${index === 0 ? 'opacity-85 z-[2]' : 'opacity-0 z-[1]'}`}
        loading={index === 0 ? "eager" : "lazy"}
        decoding="async"
        fetchpriority={index === 0 ? "high" : "low"}
        width="1200"
        height="800"
      />
    ))}
    <!-- Softened dark overlay for vivid, bright photos while maintaining crisp text contrast -->
    <div class="absolute inset-0 bg-gradient-to-t from-slate-950/80 via-slate-950/40 to-slate-950/20 z-[3]"></div>

    <!-- Branded Logo Silhouette Watermark (Bottom-Right Anchor for Clean Asymmetric Identity) -->
    <div class="absolute -bottom-10 -right-10 sm:-bottom-16 sm:-right-16 lg:-bottom-20 lg:-right-20 z-[4] pointer-events-none select-none overflow-hidden" aria-hidden="true">
      <img
        src="/images/logo-white.webp"
        alt=""
        class="w-64 h-64 sm:w-80 sm:h-80 lg:w-[480px] lg:h-[480px] object-contain opacity-20 mix-blend-screen transform -rotate-12 filter drop-shadow-2xl"
        loading="eager"
        decoding="async"
        width="480"
        height="480"
      />
    </div>
  </div>

  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full">
    <div class="max-w-4xl mx-auto text-center">
      
      <!-- Top Pill Indicator (Apple Frosted Glass) with comfortable margin from sticky navbar -->
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full glass-apple-pill text-slate-100 text-xs font-semibold mb-4 sm:mb-5 shadow-xs mt-2 sm:mt-0">
        <!-- Lucide MapPin -->
        <svg class="w-3.5 h-3.5 text-iceblue-300 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"></path>
          <circle cx="12" cy="10" r="3"></circle>
        </svg>
        <span data-i18n="topbar.badge1">Siaga 24 Jam Non-Stop</span>
        <span class="text-slate-400">•</span>
        <span class="text-iceblue-200" data-i18n="topbar.badge2">Respon Tiba 60 Menit</span>
      </div>

      <!-- Main H1 Headline: Pulled down with generous breathing room -->
      <h1 class="text-2xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-tight leading-[1.2] mb-4 sm:mb-5">
        <span data-i18n="hero.title_1">Servis & Cuci AC Panggilan Cepat</span> <span data-i18n="hero.in">di</span> <span class="text-iceblue-400">Denpasar, Badung</span>, <span data-i18n="hero.title_2">dan Sekitarnya</span>
      </h1>

      <!-- Sub-headline: Punchy on mobile, comprehensive on tablet/desktop -->
      <p class="text-sm sm:text-base text-slate-100 font-normal leading-relaxed mb-6 sm:mb-8 max-w-2xl mx-auto">
        <span data-i18n="hero.desc_lead">Spesialis pendingin udara panggilan cepat di Bali.</span><span class="hidden sm:inline" data-i18n="hero.desc_detail"> Teknisi ahli berpengalaman siap menuju rumah, villa, kos, dan kantor Anda dengan tarif transparan dan garansi 30 hari penuh.</span>
      </p>

      <!-- Primary & Secondary CTA Buttons -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-3 sm:gap-4 mb-7 sm:mb-9">
        <!-- Primary WhatsApp CTA Button -->
        <a
          href={primaryWaUrl}
          target="_blank"
          rel="noopener noreferrer"
          data-open-modal
          data-service="Panggilan Cepat (Cuci / Perbaikan AC)"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2.5 btn-cta-whatsapp text-slate-950 font-bold text-sm sm:text-base px-6 py-3 sm:px-7 sm:py-3.5 rounded-xl shadow-lg cursor-pointer"
        >
          <!-- Official Lucide MessageCircle (100% Symmetrical) -->
          <svg class="w-5 h-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"></path>
          </svg>
          <span data-i18n="hero.btn_order">Pesan Teknisi Sekarang</span>
        </a>

        <!-- Secondary Pricing CTA Button (Apple Glass) -->
        <a
          href="#tarif"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 text-white font-bold text-sm sm:text-base px-6 py-3 sm:px-7 sm:py-3.5 rounded-xl glass-apple-pill shadow-xs"
        >
          <!-- Official Lucide Banknote -->
          <svg class="w-5 h-5 shrink-0 text-iceblue-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect width="20" height="12" x="2" y="6" rx="2"></rect>
            <circle cx="12" cy="12" r="2"></circle>
            <path d="M6 12h.01M18 12h.01"></path>
          </svg>
          <span data-i18n="hero.btn_pricing">Lihat Daftar Tarif</span>
        </a>
      </div>

      <!-- Trust Badges: Unified Single Horizontal Glass Card on Mobile & Desktop -->
      <div class="glass-apple-dark rounded-2xl p-2 sm:p-3.5 max-w-4xl mx-auto shadow-lg border border-white/10">
        <div class="grid grid-cols-3 divide-x divide-white/10 items-center">
          
          <!-- Trust Badge 1: Garansi 30 Hari -->
          <div class="px-2 sm:px-4 py-1.5 flex flex-col sm:flex-row items-center sm:items-start gap-1.5 sm:gap-3.5 text-center sm:text-left">
            <div class="w-7 h-7 sm:w-10 sm:h-10 rounded-lg sm:rounded-xl bg-iceblue-500/20 text-iceblue-300 border border-iceblue-300/30 flex items-center justify-center shrink-0 shadow-inner">
              <!-- Official Lucide ShieldCheck -->
              <svg class="w-3.5 h-3.5 sm:w-5 sm:h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                <path d="m9 12 2 2 4-4"></path>
              </svg>
            </div>
            <div class="min-w-0">
              <h2 class="font-bold text-white text-[11px] sm:text-sm leading-tight" data-i18n="hero.trust1_title">Garansi 30 Hari Penuh</h2>
              <p class="hidden sm:block text-xs text-slate-200 mt-0.5" data-i18n="hero.trust1_desc">Klaim mudah jika kendala kembali muncul.</p>
            </div>
          </div>

          <!-- Trust Badge 2: Multi-Merek -->
          <div class="px-2 sm:px-4 py-1.5 flex flex-col sm:flex-row items-center sm:items-start gap-1.5 sm:gap-3.5 text-center sm:text-left">
            <div class="w-7 h-7 sm:w-10 sm:h-10 rounded-lg sm:rounded-xl bg-navy-500/30 text-iceblue-300 border border-navy-300/30 flex items-center justify-center shrink-0 shadow-inner">
              <!-- Official Lucide Wrench -->
              <svg class="w-3.5 h-3.5 sm:w-5 sm:h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"></path>
              </svg>
            </div>
            <div class="min-w-0">
              <h2 class="font-bold text-white text-[11px] sm:text-sm leading-tight" data-i18n="hero.trust2_title">Teknisi Multi-Merek</h2>
              <p class="hidden sm:block text-xs text-slate-200 mt-0.5" data-i18n="hero.trust2_desc">Daikin, Panasonic, Sharp, Gree, LG.</p>
            </div>
          </div>

          <!-- Trust Badge 3: Tanpa Biaya Tersembunyi -->
          <div class="px-2 sm:px-4 py-1.5 flex flex-col sm:flex-row items-center sm:items-start gap-1.5 sm:gap-3.5 text-center sm:text-left">
            <div class="w-7 h-7 sm:w-10 sm:h-10 rounded-lg sm:rounded-xl bg-emerald-500/20 text-emerald-300 border border-emerald-300/30 flex items-center justify-center shrink-0 shadow-inner">
              <!-- Official Lucide CheckCircle2 -->
              <svg class="w-3.5 h-3.5 sm:w-5 sm:h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"></circle>
                <path d="m9 12 2 2 4-4"></path>
              </svg>
            </div>
            <div class="min-w-0">
              <h2 class="font-bold text-white text-[11px] sm:text-sm leading-tight" data-i18n="hero.trust3_title">Tanpa Biaya Tersembunyi</h2>
              <p class="hidden sm:block text-xs text-slate-200 mt-0.5" data-i18n="hero.trust3_desc">Tarif transparan disetujui di awal.</p>
            </div>
          </div>

        </div>
      </div>

    </div>
  </div>
</section>

<script>
  function initHeroCarousel() {
    const slides = document.querySelectorAll<HTMLImageElement>('.hero-slide');
    if (slides.length <= 1) return;
    let currentIndex = 0;
    setInterval(() => {
      const prevIndex = currentIndex;
      currentIndex = (currentIndex + 1) % slides.length;

      slides.forEach((slide, idx) => {
        if (idx === currentIndex) {
          slide.classList.remove('opacity-0', 'z-[1]');
          slide.classList.add('opacity-85', 'z-[2]');
        } else if (idx === prevIndex) {
          slide.classList.remove('opacity-85', 'z-[2]');
          slide.classList.add('opacity-0', 'z-[1]');
        } else {
          slide.classList.remove('opacity-85', 'z-[2]');
          slide.classList.add('opacity-0', 'z-[0]');
        }
      });
    }, 4500);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initHeroCarousel);
  } else {
    initHeroCarousel();
  }
</script>
