---
import { siteConfig, createWhatsAppLink } from '../config/site';

const primaryWaUrl = createWhatsAppLink({
  service: "Panggilan Cepat (Cuci / Perbaikan AC)",
  notes: "Mohon info ketersediaan teknisi terdekat hari ini",
});
---

<section class="relative min-h-[640px] lg:min-h-[720px] flex items-center justify-center pt-14 pb-20 sm:pt-20 sm:pb-28 overflow-hidden bg-slate-950">
  
  <!-- Clearly Visible Hero Background Photo with Subtle Dark Cinematic Gradient -->
  <div class="absolute inset-0 z-0">
    <img
      src={siteConfig.heroImage}
      alt="Teknisi profesional AC di Denpasar Badung Bali"
      class="w-full h-full object-cover object-center opacity-80 filter brightness-95 contrast-105"
      loading="eager"
      decoding="async"
    />
    <!-- Clean dark overlay for crisp text contrast without hiding the photo -->
    <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/65 to-slate-950/45"></div>
  </div>

  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full">
    <div class="max-w-4xl mx-auto text-center">
      
      <!-- Top Pill Indicator (Apple Frosted Glass) -->
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full glass-apple-pill text-slate-100 text-xs sm:text-sm font-semibold mb-6 shadow-sm">
        <!-- Lucide MapPin -->
        <svg class="w-3.5 h-3.5 text-iceblue-300 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"></path>
          <circle cx="12" cy="10" r="3"></circle>
        </svg>
        <span>Layanan Teknisi AC Panggilan di Bali</span>
        <span class="text-slate-400">•</span>
        <span class="text-iceblue-200">Respon 60 Menit</span>
      </div>

      <!-- Main H1 Headline -->
      <h1 class="text-3xl sm:text-5xl lg:text-6xl font-extrabold text-white tracking-tight leading-[1.18] mb-6 drop-shadow-md">
        Jasa Servis & Cuci AC Panggilan Cepat di <span class="text-gradient-ice">Denpasar, Badung</span>, dan Sekitarnya
      </h1>

      <!-- Sub-headline -->
      <p class="text-base sm:text-xl text-slate-100 font-normal leading-relaxed mb-9 sm:mb-11 max-w-3xl mx-auto drop-shadow-sm">
        Teknisi ahli berpengalaman siap menuju rumah, villa, kos, dan kantor Anda di seluruh Bali. Pengerjaan rapi, tarif pasti di awal, dan bergaransi 30 hari.
      </p>

      <!-- Primary & Secondary CTA Buttons -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4 sm:gap-5 mb-12 sm:mb-16">
        <!-- Primary WhatsApp CTA Button -->
        <a
          href={primaryWaUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-3 btn-cta-whatsapp text-slate-950 font-bold text-base sm:text-lg px-8 py-4 rounded-2xl shadow-lg"
        >
          <!-- WhatsApp Icon -->
          <svg class="w-6 h-6 fill-current shrink-0" viewBox="0 0 24 24">
            <path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2zm.01 1.67c4.54 0 8.24 3.7 8.24 8.24 0 2.2-.86 4.27-2.42 5.82a8.19 8.19 0 0 1-5.82 2.42c-1.48 0-2.93-.4-4.2-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.2 8.2 0 0 1-1.26-4.38c0-4.54 3.7-8.24 8.24-8.24zm4.5 11.66c-.25-.13-1.47-.72-1.7-.81-.23-.08-.39-.13-.56.13-.17.25-.64.81-.79.97-.14.17-.29.19-.54.06-.25-.13-1.07-.39-2.03-1.25-.75-.67-1.26-1.5-1.4-1.75-.15-.25-.02-.39.11-.51.11-.11.25-.29.38-.44.12-.14.17-.25.25-.42.08-.17.04-.31-.02-.44-.06-.13-.56-1.35-.77-1.85-.2-.49-.41-.42-.56-.43l-.48-.01c-.17 0-.44.06-.67.31-.23.25-.88.86-.88 2.1 0 1.24.9 2.44 1.03 2.61.13.17 1.78 2.71 4.3 3.8 2.52 1.09 2.52.73 2.98.69.45-.05 1.47-.6 1.68-1.18.21-.58.21-1.08.15-1.18-.06-.11-.23-.17-.48-.29z"/>
          </svg>
          <span>Panggil Teknisi via WhatsApp</span>
        </a>

        <!-- Secondary Pricing CTA Button (Apple Glass) -->
        <a
          href="#tarif"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2.5 text-white font-bold text-base sm:text-lg px-8 py-4 rounded-2xl glass-apple-pill hover:bg-white/20 transition-all shadow-md"
        >
          <!-- Lucide Receipt -->
          <svg class="w-5 h-5 text-iceblue-300 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M4 2v20l2-1 2 1 2-1 2 1 2-1 2 1 2-1 2 1V2l-2 1-2-1-2 1-2-1-2 1-2-1-2 1-2-1Z"></path>
            <path d="M16 8h-8"></path>
            <path d="M16 12h-8"></path>
            <path d="M12 16h-4"></path>
          </svg>
          <span>Lihat Daftar Tarif</span>
        </a>
      </div>

      <!-- Trust Badges Grid (Apple Vibrant Frosted Glass) -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 max-w-4xl mx-auto text-left">
        
        <!-- Trust Badge 1: Garansi 30 Hari -->
        <div class="glass-apple-dark p-4 rounded-2xl flex items-center gap-3.5 transition-all">
          <div class="w-11 h-11 rounded-xl bg-iceblue-500/20 text-iceblue-300 border border-iceblue-300/30 flex items-center justify-center shrink-0 shadow-inner">
            <!-- Official Lucide ShieldCheck -->
            <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
              <path d="m9 12 2 2 4-4"></path>
            </svg>
          </div>
          <div>
            <h2 class="font-bold text-white text-sm">Garansi 30 Hari</h2>
            <p class="text-xs text-slate-200">Klaim mudah & gratis jika kendala kembali muncul.</p>
          </div>
        </div>

        <!-- Trust Badge 2: Multi-Merek -->
        <div class="glass-apple-dark p-4 rounded-2xl flex items-center gap-3.5 transition-all">
          <div class="w-11 h-11 rounded-xl bg-navy-500/30 text-iceblue-300 border border-navy-300/30 flex items-center justify-center shrink-0 shadow-inner">
            <!-- Official Lucide Wrench -->
            <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"></path>
            </svg>
          </div>
          <div>
            <h2 class="font-bold text-white text-sm">Teknisi Multi-Merek</h2>
            <p class="text-xs text-slate-200">Daikin, Panasonic, Sharp, Gree, LG, Changhong.</p>
          </div>
        </div>

        <!-- Trust Badge 3: Tanpa Biaya Tersembunyi -->
        <div class="glass-apple-dark p-4 rounded-2xl flex items-center gap-3.5 transition-all">
          <div class="w-11 h-11 rounded-xl bg-emerald-500/20 text-emerald-300 border border-emerald-300/30 flex items-center justify-center shrink-0 shadow-inner">
            <!-- Official Lucide CheckCircle2 -->
            <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"></circle>
              <path d="m9 12 2 2 4-4"></path>
            </svg>
          </div>
          <div>
            <h2 class="font-bold text-white text-sm">Tanpa Biaya Tersembunyi</h2>
            <p class="text-xs text-slate-200">Tarif pasti disetujui di awal sebelum pengerjaan.</p>
          </div>
        </div>

      </div>

    </div>
  </div>
</section>
