---
import { siteConfig, createWhatsAppLink } from '../config/site';

const primaryWaUrl = createWhatsAppLink({
  service: "Panggilan Cepat (Cuci / Perbaikan AC)",
  notes: "Halo Jawara Teknik, saya butuh bantuan teknisi AC untuk hari ini di Bali.",
});
---

<section id="hero" class="relative min-h-[calc(100vh-80px)] max-h-[820px] flex items-center justify-center pt-6 pb-8 sm:pt-8 sm:pb-10 lg:pt-8 lg:pb-10 overflow-hidden bg-slate-950">
  
  <!-- Clearly Visible Hero Background Photo with Subtle Dark Cinematic Gradient -->
  <div class="absolute inset-0 z-0">
    <img
      src={siteConfig.heroImage}
      alt="Teknisi profesional AC di Denpasar Badung Bali"
      class="w-full h-full object-cover object-center opacity-80 filter brightness-95 contrast-105"
      loading="eager"
      decoding="async"
      fetchpriority="high"
      width="1920"
      height="1080"
    />
    <!-- Clean dark overlay for crisp text contrast without hiding the photo -->
    <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/65 to-slate-950/45"></div>
  </div>

  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full">
    <div class="max-w-4xl mx-auto text-center">
      
      <!-- Top Pill Indicator (Apple Frosted Glass) -->
      <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full glass-apple-pill text-slate-100 text-xs font-semibold mb-3 sm:mb-4 shadow-xs">
        <!-- Lucide MapPin -->
        <svg class="w-3.5 h-3.5 text-iceblue-300 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"></path>
          <circle cx="12" cy="10" r="3"></circle>
        </svg>
        <span data-i18n="topbar.badge1">Siaga 24 Jam Non-Stop</span>
        <span class="text-slate-400">•</span>
        <span class="text-iceblue-200" data-i18n="topbar.badge2">Respon Tiba 60 Menit</span>
      </div>

      <!-- Main H1 Headline -->
      <h1 class="text-2xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-tight leading-[1.15] mb-3 sm:mb-4">
        <span data-i18n="hero.title_1">Servis & Cuci AC Panggilan Cepat</span> <span data-i18n="hero.in">di</span> <span class="text-iceblue-400">Denpasar, Badung</span>, <span data-i18n="hero.title_2">dan Sekitarnya</span>
      </h1>

      <!-- Sub-headline -->
      <p class="text-sm sm:text-base text-slate-100 font-normal leading-relaxed mb-6 sm:mb-7 max-w-2xl mx-auto" data-i18n="hero.desc">
        Spesialis pendingin udara panggilan cepat di Bali. Teknisi ahli berpengalaman siap menuju rumah, villa, kos, dan kantor Anda. Pengerjaan rapi, tarif transparan di awal, dan garansi 30 hari penuh.
      </p>

      <!-- Primary & Secondary CTA Buttons -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-3 sm:gap-4 mb-7 sm:mb-9">
        <!-- Primary WhatsApp CTA Button -->
        <a
          href={primaryWaUrl}
          target="_blank"
          rel="noopener noreferrer"
          data-open-modal
          data-service="Panggilan Cepat (Cuci / Perbaikan AC)"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2.5 btn-cta-whatsapp text-slate-950 font-bold text-sm sm:text-base px-6 py-3 sm:px-7 sm:py-3.5 rounded-xl shadow-lg cursor-pointer"
        >
          <!-- Official Lucide MessageCircle (100% Symmetrical) -->
          <svg class="w-5 h-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"></path>
          </svg>
          <span data-i18n="hero.btn_order">Pesan Teknisi Sekarang</span>
        </a>

        <!-- Secondary Pricing CTA Button (Apple Glass) -->
        <a
          href="#tarif"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 text-white font-bold text-sm sm:text-base px-6 py-3 sm:px-7 sm:py-3.5 rounded-xl glass-apple-pill shadow-xs"
        >
          <!-- Official Lucide Banknote -->
          <svg class="w-5 h-5 shrink-0 text-iceblue-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect width="20" height="12" x="2" y="6" rx="2"></rect>
            <circle cx="12" cy="12" r="2"></circle>
            <path d="M6 12h.01M18 12h.01"></path>
          </svg>
          <span data-i18n="hero.btn_pricing">Lihat Daftar Tarif</span>
        </a>
      </div>

      <!-- Trust Badges Grid (Apple Vibrant Frosted Glass) -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-3 sm:gap-4 max-w-4xl mx-auto text-left">
        
        <!-- Trust Badge 1: Garansi 30 Hari -->
        <div class="glass-apple-dark p-3 sm:p-3.5 rounded-xl flex items-center gap-3 transition-all">
          <div class="w-9 h-9 sm:w-10 sm:h-10 rounded-lg bg-iceblue-500/20 text-iceblue-300 border border-iceblue-300/30 flex items-center justify-center shrink-0 shadow-inner">
            <!-- Official Lucide ShieldCheck -->
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
              <path d="m9 12 2 2 4-4"></path>
            </svg>
          </div>
          <div>
            <h2 class="font-bold text-white text-xs sm:text-sm" data-i18n="hero.trust1_title">Garansi 30 Hari Penuh</h2>
            <p class="text-xs text-slate-200" data-i18n="hero.trust1_desc">Klaim mudah jika kendala kembali muncul.</p>
          </div>
        </div>

        <!-- Trust Badge 2: Multi-Merek -->
        <div class="glass-apple-dark p-3 sm:p-3.5 rounded-xl flex items-center gap-3 transition-all">
          <div class="w-9 h-9 sm:w-10 sm:h-10 rounded-lg bg-navy-500/30 text-iceblue-300 border border-navy-300/30 flex items-center justify-center shrink-0 shadow-inner">
            <!-- Official Lucide Wrench -->
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"></path>
            </svg>
          </div>
          <div>
            <h2 class="font-bold text-white text-xs sm:text-sm" data-i18n="hero.trust2_title">Teknisi Multi-Merek</h2>
            <p class="text-xs text-slate-200" data-i18n="hero.trust2_desc">Daikin, Panasonic, Sharp, Gree, LG.</p>
          </div>
        </div>

        <!-- Trust Badge 3: Tanpa Biaya Tersembunyi -->
        <div class="glass-apple-dark p-3 sm:p-3.5 rounded-xl flex items-center gap-3 transition-all">
          <div class="w-9 h-9 sm:w-10 sm:h-10 rounded-lg bg-emerald-500/20 text-emerald-300 border border-emerald-300/30 flex items-center justify-center shrink-0 shadow-inner">
            <!-- Official Lucide CheckCircle2 -->
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"></circle>
              <path d="m9 12 2 2 4-4"></path>
            </svg>
          </div>
          <div>
            <h2 class="font-bold text-white text-xs sm:text-sm" data-i18n="hero.trust3_title">Tanpa Biaya Tersembunyi</h2>
            <p class="text-xs text-slate-200" data-i18n="hero.trust3_desc">Tarif transparan disetujui di awal.</p>
          </div>
        </div>

      </div>

    </div>
  </div>
</section>
