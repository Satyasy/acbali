---
import { siteConfig, createWhatsAppLink } from '../config/site';

const currentYear = new Date().getFullYear();
const waFooterLink = createWhatsAppLink();
---

<footer class="bg-navy-950 text-white pt-16 pb-12 border-t border-navy-800">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 mb-12">
      
      <!-- Brand & NAP Column -->
      <div class="lg:col-span-5 space-y-4">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-iceblue-500 to-navy-700 flex items-center justify-center text-white font-black text-xl shadow-md">
            JT
          </div>
          <div>
            <h3 class="font-extrabold text-xl tracking-tight text-white">{siteConfig.legalName}</h3>
            <p class="text-xs text-iceblue-300">Spesialis Pendingin Udara Panggilan Cepat di Bali</p>
          </div>
        </div>

        <p class="text-xs sm:text-sm text-slate-300 leading-relaxed max-w-md">
          {siteConfig.description}
        </p>

        <!-- NAP (Name, Address, Phone) Details -->
        <div class="space-y-2.5 pt-2 text-xs sm:text-sm text-slate-300">
          <div class="flex items-start gap-2.5">
            <!-- Lucide MapPin -->
            <svg class="w-4 h-4 text-iceblue-400 shrink-0 mt-0.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            <span>{siteConfig.address.full}</span>
          </div>

          <div class="flex items-center gap-2.5">
            <!-- Lucide Phone -->
            <svg class="w-4 h-4 text-iceblue-400 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
            <a href={`tel:${siteConfig.phoneRaw}`} class="hover:text-iceblue-300 transition-colors font-semibold">
              {siteConfig.phone}
            </a>
          </div>

          <div class="flex items-center gap-2.5">
            <!-- Lucide Clock -->
            <svg class="w-4 h-4 text-emerald-400 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <span class="font-medium text-emerald-300">{siteConfig.operatingHoursShort}</span>
          </div>
        </div>

        <div class="pt-2">
          <a
            href={waFooterLink}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 glass-cta-bubble text-slate-950 font-bold px-5 py-2.5 rounded-xl text-xs"
          >
            <span>Hubungi via WhatsApp Resmi</span>
            <span>&rarr;</span>
          </a>
        </div>
      </div>

      <!-- Quick Links Column -->
      <div class="lg:col-span-3 space-y-3">
        <h4 class="font-bold text-sm text-white uppercase tracking-wider mb-4 border-b border-navy-800 pb-2">
          Menu & Layanan
        </h4>
        <ul class="space-y-2 text-xs sm:text-sm text-slate-300">
          <li><a href="#masalah" class="hover:text-iceblue-400 transition-colors">Keluhan & Kendala AC</a></li>
          <li><a href="#tarif" class="hover:text-iceblue-400 transition-colors">Daftar Tarif Servis</a></li>
          <li><a href="#tarif" class="hover:text-iceblue-400 transition-colors">Servis AC Inverter</a></li>
          <li><a href="#tarif" class="hover:text-iceblue-400 transition-colors">Isi & Tambah Freon R32/R410a</a></li>
          <li><a href="#paket-villa" class="hover:text-iceblue-400 transition-colors">Paket Villa & Homestay</a></li>
          <li><a href="#wilayah" class="hover:text-iceblue-400 transition-colors">Cakupan Area Bali</a></li>
          <li><a href="#cara-order" class="hover:text-iceblue-400 transition-colors">3 Langkah Pemesanan</a></li>
          <li><a href="#faq" class="hover:text-iceblue-400 transition-colors">Tanya Jawab (FAQ)</a></li>
        </ul>
      </div>

      <!-- Google Maps Integration Column -->
      <div class="lg:col-span-4 space-y-3">
        <div class="flex items-center justify-between border-b border-navy-800 pb-2 mb-3">
          <h4 class="font-bold text-sm text-white uppercase tracking-wider">
            Lokasi Bengkel & Kantor
          </h4>
          <a
            href={siteConfig.mapsDirectUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="text-[11px] text-iceblue-400 hover:text-iceblue-300 underline"
          >
            Buka Maps &rarr;
          </a>
        </div>

        <div class="w-full h-48 sm:h-52 rounded-2xl overflow-hidden border border-navy-700 shadow-inner relative bg-navy-900">
          <iframe
            title="Lokasi Jawara Teknik di Google Maps"
            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3944.3824141673857!2d115.2052445!3d-8.672815!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x2dd2409b5585b73d%3A0x7d2ecbf6c5476a3!2sJl.%20Teuku%20Umar%2C%20Kota%20Denpasar%2C%20Bali!5e0!3m2!1sid!2sid!4v1700000000000!5m2!1sid!2sid"
            width="100%"
            height="100%"
            style="border:0;"
            allowfullscreen=""
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            class="filter grayscale contrast-125 opacity-90 hover:grayscale-0 hover:opacity-100 transition-all duration-300"
          ></iframe>
        </div>
        <div class="flex items-center gap-1.5 text-[11px] text-slate-400 pt-1">
          <!-- Lucide MapPin -->
          <svg class="w-3.5 h-3.5 text-iceblue-400 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
          </svg>
          <span>Melayani panggilan cepat ke Denpasar, Canggu, Kuta, Seminyak, Sanur, Jimbaran, Ubud, dan sekitarnya.</span>
        </div>
      </div>

    </div>

    <!-- Bottom Copyright & Badges -->
    <div class="pt-8 border-t border-navy-900 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-500">
      <p>© {currentYear} {siteConfig.legalName}. Hak Cipta Dilindungi.</p>
      <div class="flex items-center gap-4">
        <span>Teknisi Berpengalaman & Bersertifikat</span>
        <span>•</span>
        <span>Garansi 30 Hari</span>
      </div>
    </div>
  </div>
</footer>
