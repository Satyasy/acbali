---
import { siteConfig, createWhatsAppLink } from '../config/site';

const currentYear = new Date().getFullYear();
const waFooterLink = createWhatsAppLink();
---

<footer class="relative bg-navy-950 text-white pt-16 pb-12 border-t border-navy-800 overflow-hidden">
  <!-- Architectural Dark Blueprint Grid for Footer -->
  <div class="absolute inset-0 pointer-events-none select-none overflow-hidden" aria-hidden="true">
    <div class="w-full h-full bg-grid-blueprint-dark [mask-image:radial-gradient(ellipse_80%_70%_at_50%_30%,black_30%,transparent_100%)] opacity-60"></div>
  </div>
  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 mb-12">
      
      <!-- Brand & NAP Column -->
      <div class="lg:col-span-5 space-y-4">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 sm:w-11 sm:h-11 rounded-xl bg-navy-800 text-iceblue-400 flex items-center justify-center shadow-xs border border-navy-700">
            <!-- Official Symmetrical Lucide Snowflake -->
            <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="2" x2="22" y1="12" y2="12"></line>
              <line x1="12" x2="12" y1="2" y2="22"></line>
              <path d="m20 16-4-4 4-4"></path>
              <path d="m4 8 4 4-4 4"></path>
              <path d="m16 4-4 4-4-4"></path>
              <path d="m8 20 4-4 4 4"></path>
            </svg>
          </div>
          <div>
            <h3 class="font-extrabold text-xl tracking-tight text-white">{siteConfig.legalName}</h3>
            <p class="text-xs text-iceblue-300">Spesialis Pendingin Udara Panggilan Cepat di Bali</p>
          </div>
        </div>

        <p class="text-xs sm:text-sm text-slate-300 leading-relaxed max-w-md">
          {siteConfig.description}
        </p>

        <!-- NAP (Name, Address, Phone) Details -->
        <div class="space-y-2.5 pt-2 text-xs sm:text-sm text-slate-300">
          <div class="flex items-start gap-2.5">
            <!-- Lucide MapPin -->
            <svg class="w-4 h-4 text-iceblue-400 shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"></path>
              <circle cx="12" cy="10" r="3"></circle>
            </svg>
            <span>{siteConfig.address.full}</span>
          </div>

          <div class="flex items-center gap-2.5">
            <!-- Lucide Phone -->
            <svg class="w-4 h-4 text-iceblue-400 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
            </svg>
            <a href={`tel:${siteConfig.phoneRaw}`} class="hover:text-iceblue-300 transition-colors font-semibold">
              {siteConfig.phone}
            </a>
          </div>

          <div class="flex items-center gap-2.5">
            <!-- Lucide Clock -->
            <svg class="w-4 h-4 text-iceblue-400 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"></circle>
              <polyline points="12 6 12 12 16 14"></polyline>
            </svg>
            <span class="font-medium text-slate-200">{siteConfig.operatingHoursShort}</span>
          </div>
        </div>

        <div class="pt-2">
          <a
            href={waFooterLink}
            target="_blank"
            rel="noopener noreferrer"
            class="group/footer inline-flex items-center gap-2.5 btn-cta-whatsapp text-slate-950 font-bold px-5 py-2.5 rounded-xl text-xs shadow-md"
          >
            <!-- Official Lucide MessageCircle -->
            <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"></path>
            </svg>
            <span>Hubungi via WhatsApp Resmi</span>
            <svg class="w-3.5 h-3.5 shrink-0 transform group-hover/footer:translate-x-1 transition-transform duration-200 ease-out" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M5 12h14"></path>
              <path d="m12 5 7 7-7 7"></path>
            </svg>
          </a>
        </div>
      </div>

      <!-- Quick Links Column -->
      <div class="lg:col-span-3 space-y-3">
        <h4 class="font-bold text-sm text-white uppercase tracking-wider mb-4 border-b border-navy-800 pb-2">
          Menu & Layanan
        </h4>
        <ul class="space-y-2 text-xs sm:text-sm text-slate-300">
          <li><a href="#masalah" class="hover:text-iceblue-400 transition-colors">Keluhan & Kendala AC</a></li>
          <li><a href="#tarif" class="hover:text-iceblue-400 transition-colors">Daftar Tarif Servis</a></li>
          <li><a href="#tarif" class="hover:text-iceblue-400 transition-colors">Servis AC Inverter</a></li>
          <li><a href="#tarif" class="hover:text-iceblue-400 transition-colors">Isi & Tambah Freon R32/R410a</a></li>
          <li><a href="#paket-villa" class="hover:text-iceblue-400 transition-colors">Paket Villa & Homestay</a></li>
          <li><a href="#wilayah" class="hover:text-iceblue-400 transition-colors">Cakupan Area Bali</a></li>
          <li><a href="#cara-order" class="hover:text-iceblue-400 transition-colors">3 Langkah Pemesanan</a></li>
          <li><a href="#faq" class="hover:text-iceblue-400 transition-colors">Tanya Jawab (FAQ)</a></li>
        </ul>
      </div>

      <!-- Google Maps Integration Column -->
      <div class="lg:col-span-4 space-y-3">
        <div class="flex items-center justify-between border-b border-navy-800 pb-2 mb-3">
          <h4 class="font-bold text-sm text-white uppercase tracking-wider">
            Lokasi Bengkel & Kantor
          </h4>
          <div class="flex items-center gap-3">
            <a
              href={siteConfig.mapsDirectUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="text-[11px] text-iceblue-400 hover:text-iceblue-300 font-semibold underline inline-flex items-center gap-1"
            >
              <span>Buka Google Maps</span>
              <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                <polyline points="15 3 21 3 21 9"></polyline>
                <line x1="10" y1="14" x2="21" y2="3"></line>
              </svg>
            </a>
          </div>
        </div>

        <div class="w-full h-48 sm:h-52 rounded-2xl overflow-hidden border border-navy-800 shadow-inner relative bg-navy-900">
          <iframe
            title="Lokasi Service AC Panggilan Jawara Teknik di Google Maps"
            src={siteConfig.mapsEmbedUrl}
            width="100%"
            height="100%"
            style="border:0;"
            allowfullscreen=""
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            class="opacity-95 hover:opacity-100 transition-opacity"
          ></iframe>
        </div>
        <div class="flex items-center gap-1.5 text-[11px] text-slate-300 pt-1">
          <!-- Lucide MapPin -->
          <svg class="w-3.5 h-3.5 text-iceblue-400 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"></path>
            <circle cx="12" cy="10" r="3"></circle>
          </svg>
          <span>Melayani panggilan cepat ke Denpasar, Canggu, Kuta, Seminyak, Sanur, Jimbaran, Ubud, dan sekitarnya.</span>
        </div>
      </div>

    </div>

    <!-- Bottom Copyright & Badges -->
    <div class="pt-8 border-t border-navy-900 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-300">
      <p>© {currentYear} {siteConfig.legalName}. Hak Cipta Dilindungi.</p>
      <div class="flex items-center gap-4">
        <span>Teknisi Berpengalaman & Bersertifikat</span>
        <span>•</span>
        <span>Garansi 30 Hari</span>
      </div>
    </div>
  </div>
</footer>
