---
import { createWhatsAppLink } from '../config/site';

const floatingWaUrl = createWhatsAppLink();
---

<!-- Floating Action Button (Bottom Right for all screen sizes) -->
<aside class="fixed bottom-5 right-5 z-50">
  <a
    href={floatingWaUrl}
    target="_blank"
    rel="noopener noreferrer"
    class="flex items-center gap-2 btn-cta-whatsapp text-slate-950 px-4 py-3 sm:px-5 sm:py-3.5 rounded-full shadow-xl hover:scale-105 transition-all duration-200"
    title="Chat Teknisi Siaga di WhatsApp"
  >
    <!-- Official Lucide MessageCircle -->
    <svg class="w-5 h-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"></path>
    </svg>
    <span class="text-xs sm:text-sm font-bold text-slate-950">Chat WhatsApp</span>
  </a>
</aside>
