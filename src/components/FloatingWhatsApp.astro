---
import { createWhatsAppLink } from '../config/site';

const floatingWaUrl = createWhatsAppLink();
---

<!-- Mobile Bottom Sticky Bar (Visible on screens < lg) -->
<div class="fixed bottom-0 left-0 right-0 z-50 p-3 bg-white/95 backdrop-blur-md border-t border-slate-200 shadow-xl lg:hidden">
  <div class="max-w-md mx-auto flex items-center gap-2">
    <a
      href={floatingWaUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="flex-1 inline-flex items-center justify-center gap-2.5 btn-cta-whatsapp text-slate-950 font-bold text-sm py-3.5 px-4 rounded-xl shadow-md transition-transform active:scale-95"
    >
      <!-- Official Lucide MessageCircle -->
      <svg class="w-5 h-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"></path>
      </svg>
      <span>Panggil Teknisi via WhatsApp</span>
    </a>
  </div>
</div>

<!-- Desktop Floating Action Button (Bottom Right) -->
<aside class="hidden lg:block fixed bottom-6 right-6 z-50">
  <a
    href={floatingWaUrl}
    target="_blank"
    rel="noopener noreferrer"
    class="flex items-center gap-2.5 btn-cta-whatsapp text-slate-950 px-5 py-3.5 rounded-full shadow-lg hover:scale-105 transition-all"
    title="Chat Teknisi Siaga di WhatsApp"
  >
    <!-- Official Lucide MessageCircle -->
    <svg class="w-5 h-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"></path>
    </svg>
    <span class="text-sm font-bold text-slate-950">Chat WhatsApp</span>
  </a>
</aside>
