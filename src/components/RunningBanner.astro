---
// Running Marquee Ticker right under Hero section
// Clean White Frosted Background, High-Contrast Typography, Squircle Badged Lucide Icons
const tickerItems = [
  {
    iconName: "zap",
    textId: "ticker.item1",
    text: "Siaga 24 Jam Non-Stop di Bali",
  },
  {
    iconName: "clock",
    textId: "ticker.item2",
    text: "Respon Cepat Tiba 60 Menit",
  },
  {
    iconName: "shield-check",
    textId: "ticker.item3",
    text: "Garansi Servis 30 Hari Penuh",
  },
  {
    iconName: "wrench",
    textId: "ticker.item4",
    text: "Teknisi Nyata Berpengalaman & Jujur",
  },
  {
    iconName: "map-pin",
    textId: "ticker.item5",
    text: "Area: Denpasar • Badung • Canggu • Seminyak • Sanur • Ubud",
  },
  {
    iconName: "building-2",
    textId: "ticker.item6",
    text: "Rumah Pribadi • Villa Mewah • Kantor • Kos • Kafe",
  },
  {
    iconName: "snowflake",
    textId: "ticker.item7",
    text: "Multi-Brand: Daikin, Panasonic, Sharp, Gree, LG",
  },
  {
    iconName: "check-circle",
    textId: "ticker.item8",
    text: "Tanpa Biaya Siluman & Konsultasi Gratis via Chat",
  },
];
---

<div class="relative overflow-hidden bg-white/95 dark:bg-[#071322]/95 border-y border-slate-200/90 dark:border-navy-800/80 backdrop-blur-md py-4 sm:py-5 z-20 select-none shadow-2xs">
  <!-- Soft Gradient Edge Masks for Clean Fade on White & Dark Background -->
  <div class="absolute left-0 top-0 bottom-0 w-12 sm:w-24 bg-gradient-to-r from-white dark:from-[#071322] to-transparent z-10 pointer-events-none"></div>
  <div class="absolute right-0 top-0 bottom-0 w-12 sm:w-24 bg-gradient-to-l from-white dark:from-[#071322] to-transparent z-10 pointer-events-none"></div>

  <!-- Ambient Cool Breeze & Ice Crystal Vapor Effect Layer -->
  <div class="absolute inset-0 pointer-events-none overflow-hidden z-[5]" aria-hidden="true">
    <div class="ticker-breeze ticker-breeze-1"></div>
    <div class="ticker-breeze ticker-breeze-2"></div>
    <span class="ticker-snowflake ticker-flake-1">❄</span>
    <span class="ticker-snowflake ticker-flake-2">❅</span>
    <span class="ticker-snowflake ticker-flake-3">❆</span>
  </div>

  <!-- Marquee Track (Double duplicate for seamless infinite loop) -->
  <div class="flex items-center w-max animate-marquee hover:[animation-play-state:paused]">
    <!-- Loop 1 -->
    <div class="flex items-center gap-12 sm:gap-16 shrink-0 pr-12 sm:pr-16">
      {tickerItems.map((item) => (
        <div class="flex items-center gap-3 whitespace-nowrap group/item">
          <!-- Sleek Rounded Squircle Badge for Lucide Icon -->
          <div class="w-8 h-8 rounded-lg bg-iceblue-50 dark:bg-iceblue-500/15 text-iceblue-700 dark:text-iceblue-300 border border-iceblue-200/80 dark:border-iceblue-400/30 flex items-center justify-center shrink-0 shadow-2xs group-hover/item:bg-iceblue-600 group-hover/item:text-white group-hover/item:border-iceblue-600 transition-all duration-200">
            {item.iconName === 'zap' && (
              <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
              </svg>
            )}
            {item.iconName === 'clock' && (
              <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"></circle>
                <polyline points="12 6 12 12 16 14"></polyline>
              </svg>
            )}
            {item.iconName === 'shield-check' && (
              <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                <path d="m9 12 2 2 4-4"></path>
              </svg>
            )}
            {item.iconName === 'wrench' && (
              <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"></path>
              </svg>
            )}
            {item.iconName === 'map-pin' && (
              <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"></path>
                <circle cx="12" cy="10" r="3"></circle>
              </svg>
            )}
            {item.iconName === 'building-2' && (
              <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M6 22V4a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v18Z"></path>
                <path d="M6 12H4a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2h2"></path>
                <path d="M18 9h2a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2h-2"></path>
                <path d="M10 6h4"></path>
                <path d="M10 10h4"></path>
                <path d="M10 14h4"></path>
                <path d="M10 18h4"></path>
              </svg>
            )}
            {item.iconName === 'snowflake' && (
              <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="2" x2="22" y1="12" y2="12"></line>
                <line x1="12" x2="12" y1="2" y2="22"></line>
                <path d="m20 16-4-4 4-4"></path>
                <path d="m4 8 4 4-4 4"></path>
                <path d="m16 4-4 4-4-4"></path>
                <path d="m8 20 4-4 4 4"></path>
              </svg>
            )}
            {item.iconName === 'check-circle' && (
              <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"></circle>
                <path d="m9 12 2 2 4-4"></path>
              </svg>
            )}
          </div>

          <span class="text-sm sm:text-base font-extrabold text-navy-950 dark:text-white tracking-tight group-hover/item:text-iceblue-700 dark:group-hover/item:text-iceblue-300 transition-colors" data-i18n={item.textId}>
            {item.text}
          </span>
          <span class="w-2 h-2 rounded-full bg-iceblue-400/60 dark:bg-iceblue-400/40 shrink-0 ml-4"></span>
        </div>
      ))}
    </div>

    <!-- Loop 2 (Exact Duplicate for Gapless Infinite Marquee) -->
    <div class="flex items-center gap-12 sm:gap-16 shrink-0 pr-12 sm:pr-16" aria-hidden="true">
      {tickerItems.map((item) => (
        <div class="flex items-center gap-3 whitespace-nowrap group/item">
          <!-- Sleek Rounded Squircle Badge for Lucide Icon -->
          <div class="w-8 h-8 rounded-lg bg-iceblue-50 dark:bg-iceblue-500/15 text-iceblue-700 dark:text-iceblue-300 border border-iceblue-200/80 dark:border-iceblue-400/30 flex items-center justify-center shrink-0 shadow-2xs group-hover/item:bg-iceblue-600 group-hover/item:text-white group-hover/item:border-iceblue-600 transition-all duration-200">
            {item.iconName === 'zap' && (
              <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
              </svg>
            )}
            {item.iconName === 'clock' && (
              <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"></circle>
                <polyline points="12 6 12 12 16 14"></polyline>
              </svg>
            )}
            {item.iconName === 'shield-check' && (
              <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                <path d="m9 12 2 2 4-4"></path>
              </svg>
            )}
            {item.iconName === 'wrench' && (
              <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"></path>
              </svg>
            )}
            {item.iconName === 'map-pin' && (
              <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"></path>
                <circle cx="12" cy="10" r="3"></circle>
              </svg>
            )}
            {item.iconName === 'building-2' && (
              <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M6 22V4a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v18Z"></path>
                <path d="M6 12H4a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2h2"></path>
                <path d="M18 9h2a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2h-2"></path>
                <path d="M10 6h4"></path>
                <path d="M10 10h4"></path>
                <path d="M10 14h4"></path>
                <path d="M10 18h4"></path>
              </svg>
            )}
            {item.iconName === 'snowflake' && (
              <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="2" x2="22" y1="12" y2="12"></line>
                <line x1="12" x2="12" y1="2" y2="22"></line>
                <path d="m20 16-4-4 4-4"></path>
                <path d="m4 8 4 4-4 4"></path>
                <path d="m16 4-4 4-4-4"></path>
                <path d="m8 20 4-4 4 4"></path>
              </svg>
            )}
            {item.iconName === 'check-circle' && (
              <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"></circle>
                <path d="m9 12 2 2 4-4"></path>
              </svg>
            )}
          </div>

          <span class="text-sm sm:text-base font-extrabold text-navy-950 dark:text-white tracking-tight group-hover/item:text-iceblue-700 dark:group-hover/item:text-iceblue-300 transition-colors" data-i18n={item.textId}>
            {item.text}
          </span>
          <span class="w-2 h-2 rounded-full bg-iceblue-400/60 dark:bg-iceblue-400/40 shrink-0 ml-4"></span>
        </div>
      ))}
    </div>
  </div>
</div>

<style>
  @keyframes marquee {
    0% {
      transform: translateX(0%);
    }
    100% {
      transform: translateX(-50%);
    }
  }

  .animate-marquee {
    animation: marquee 35s linear infinite;
    will-change: transform;
  }

  /* Ambient Cool Breeze Streaks */
  @keyframes tickerBreeze {
    0% {
      transform: translate3d(-100%, 0, 0);
      opacity: 0;
    }
    20% {
      opacity: 0.65;
    }
    80% {
      opacity: 0.65;
    }
    100% {
      transform: translate3d(200%, 0, 0);
      opacity: 0;
    }
  }

  .ticker-breeze {
    position: absolute;
    height: 1.5px;
    border-radius: 9999px;
    background: linear-gradient(90deg, transparent, rgba(56, 189, 248, 0.6), rgba(186, 230, 253, 0.9), rgba(56, 189, 248, 0.6), transparent);
    filter: blur(0.8px);
    will-change: transform;
    animation: tickerBreeze 8s cubic-bezier(0.4, 0, 0.2, 1) infinite;
  }

  .ticker-breeze-1 {
    top: 22%;
    width: 260px;
    animation-delay: 0s;
  }

  .ticker-breeze-2 {
    bottom: 22%;
    width: 320px;
    animation-duration: 11s;
    animation-delay: 4.5s;
  }

  /* Floating Ice Snowflake Particles */
  @keyframes tickerFlakeFloat {
    0% {
      transform: translate3d(-40px, 0, 0) rotate(0deg);
      opacity: 0;
    }
    15% {
      opacity: 0.6;
    }
    85% {
      opacity: 0.6;
    }
    100% {
      transform: translate3d(calc(100vw + 60px), 0, 0) rotate(360deg);
      opacity: 0;
    }
  }

  .ticker-snowflake {
    position: absolute;
    color: #38BDF8;
    filter: drop-shadow(0 0 6px rgba(56, 189, 248, 0.6));
    will-change: transform;
    animation: tickerFlakeFloat linear infinite;
    pointer-events: none;
    font-size: 13px;
  }

  .ticker-flake-1 {
    top: 18%;
    animation-duration: 15s;
    animation-delay: 0.5s;
  }

  .ticker-flake-2 {
    top: 58%;
    animation-duration: 19s;
    animation-delay: 6s;
    font-size: 11px;
    color: #7DD3FC;
  }

  .ticker-flake-3 {
    top: 38%;
    animation-duration: 13s;
    animation-delay: 10s;
    font-size: 15px;
    color: #BAE6FD;
  }

  @media (prefers-reduced-motion: reduce) {
    .animate-marquee {
      animation: none;
      overflow-x: auto;
    }
    .ticker-breeze,
    .ticker-snowflake {
      display: none !important;
    }
  }
</style>
