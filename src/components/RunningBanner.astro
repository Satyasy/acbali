---
// Running Marquee Ticker right under Hero section (Apple Frosted Dark Navy)
const tickerItems = [
  { icon: "⚡", textId: "ticker.item1", text: "Siaga 24 Jam Non-Stop di Bali" },
  { icon: "⏱️", textId: "ticker.item2", text: "Respon Cepat Tiba 60 Menit" },
  { icon: "🛡️", textId: "ticker.item3", text: "Garansi Servis 30 Hari Penuh" },
  { icon: "👨‍🔧", textId: "ticker.item4", text: "Teknisi Nyata Berpengalaman & Jujur" },
  { icon: "📍", textId: "ticker.item5", text: "Area: Denpasar • Badung • Canggu • Seminyak • Sanur • Ubud" },
  { icon: "🏡", textId: "ticker.item6", text: "Rumah Pribadi • Villa Mewah • Kantor • Kos • Kafe" },
  { icon: "❄️", textId: "ticker.item7", text: "Multi-Brand: Daikin, Panasonic, Sharp, Gree, LG" },
  { icon: "💬", textId: "ticker.item8", text: "Tanpa Biaya Siluman & Konsultasi Gratis via Chat" },
];
---

<div class="relative overflow-hidden bg-navy-950/95 border-y border-navy-800/80 backdrop-blur-md py-3 z-20 select-none shadow-xs">
  <!-- Soft Gradient Edge Masks for Smooth Fade -->
  <div class="absolute left-0 top-0 bottom-0 w-12 sm:w-20 bg-gradient-to-r from-navy-950 to-transparent z-10 pointer-events-none"></div>
  <div class="absolute right-0 top-0 bottom-0 w-12 sm:w-20 bg-gradient-to-l from-navy-950 to-transparent z-10 pointer-events-none"></div>

  <!-- Marquee Track (Double duplicate for seamless infinite loop) -->
  <div class="flex items-center w-max animate-marquee hover:[animation-play-state:paused]">
    <!-- Loop 1 -->
    <div class="flex items-center gap-6 sm:gap-10 shrink-0 pr-6 sm:pr-10">
      {tickerItems.map((item) => (
        <div class="flex items-center gap-2.5 whitespace-nowrap">
          <span class="text-base shrink-0">{item.icon}</span>
          <span class="text-xs sm:text-sm font-bold text-slate-200 tracking-wide" data-i18n={item.textId}>
            {item.text}
          </span>
          <span class="w-1.5 h-1.5 rounded-full bg-iceblue-400 shrink-0 ml-3 opacity-60"></span>
        </div>
      ))}
    </div>

    <!-- Loop 2 (Exact Duplicate for Gapless Marquee) -->
    <div class="flex items-center gap-6 sm:gap-10 shrink-0 pr-6 sm:pr-10" aria-hidden="true">
      {tickerItems.map((item) => (
        <div class="flex items-center gap-2.5 whitespace-nowrap">
          <span class="text-base shrink-0">{item.icon}</span>
          <span class="text-xs sm:text-sm font-bold text-slate-200 tracking-wide" data-i18n={item.textId}>
            {item.text}
          </span>
          <span class="w-1.5 h-1.5 rounded-full bg-iceblue-400 shrink-0 ml-3 opacity-60"></span>
        </div>
      ))}
    </div>
  </div>
</div>

<style>
  @keyframes marquee {
    0% {
      transform: translateX(0%);
    }
    100% {
      transform: translateX(-50%);
    }
  }

  .animate-marquee {
    animation: marquee 35s linear infinite;
    will-change: transform;
  }

  @media (prefers-reduced-motion: reduce) {
    .animate-marquee {
      animation: none;
      overflow-x: auto;
    }
  }
</style>
