---
import { faqs, createWhatsAppLink } from '../config/site';

const faqWaUrl = createWhatsAppLink({
  service: "Pertanyaan Tambahan / Konsultasi Kendala AC",
});
---

<section id="faq" class="relative py-16 sm:py-24 bg-slatewhite border-b border-slate-200/60 overflow-hidden">
  <!-- Subtle Ambient Background Watermarks -->
  <div class="absolute inset-0 pointer-events-none select-none overflow-hidden" aria-hidden="true">
    <!-- Snowflake Graphic Silhouette (Top-Right) -->
    <svg class="absolute -top-14 -right-14 w-96 h-96 text-iceblue-500/[0.035]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round">
      <line x1="2" x2="22" y1="12" y2="12"></line>
      <line x1="12" x2="12" y1="2" y2="22"></line>
      <path d="m20 16-4-4 4-4"></path>
      <path d="m4 8 4 4-4 4"></path>
      <path d="m16 4-4 4-4-4"></path>
      <path d="m8 20 4-4 4 4"></path>
    </svg>
    <!-- Breeze Flow Wave (Bottom-Left) -->
    <svg class="absolute -bottom-10 -left-10 w-[420px] h-52 text-navy-800/[0.03]" viewBox="0 0 420 180" fill="none" stroke="currentColor" stroke-width="1.8">
      <path d="M0 60 Q 140 15 280 60 T 420 60" />
      <path d="M0 110 Q 160 55 310 110 T 420 110" />
    </svg>
  </div>

  <div class="relative z-10 max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-12 sm:mb-16">
      <div class="inline-flex items-center gap-1.5 px-3.5 py-1 rounded-full bg-iceblue-50 text-iceblue-700 text-xs font-semibold mb-3 border border-iceblue-200">
        <!-- Lucide HelpCircle -->
        <svg class="w-3.5 h-3.5 text-iceblue-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <circle cx="12" cy="12" r="10" />
          <path stroke-linecap="round" stroke-linejoin="round" d="M9.09 9a3 3 0 015.83 1c0 2-3 3-3 3m.08 4h.01" />
        </svg>
        <span>Informasi Lengkap & Transparan</span>
      </div>
      <h2 class="text-2xl sm:text-4xl font-extrabold text-navy-950 tracking-tight">
        Pertanyaan yang Sering Diajukan (FAQ)
      </h2>
      <p class="mt-3.5 text-base text-slate-600">
        Jawaban seputar garansi 30 hari, pencucian AC inverter, freon, dan respon teknisi di Bali.
      </p>
    </div>

    <!-- Accordion List -->
    <div class="space-y-4">
      {faqs.map((faq) => (
        <details class="group bg-white rounded-2xl border border-slate-200/90 p-6 [&_summary::-webkit-details-marker]:hidden transition-all duration-200 open:border-iceblue-400 open:shadow-sm">
          <summary class="flex items-center justify-between cursor-pointer font-bold text-base sm:text-lg text-navy-950 list-none gap-4">
            <span class="group-hover:text-iceblue-600 transition-colors">
              {faq.question}
            </span>
            <span class="w-8 h-8 rounded-full bg-slate-100 group-open:bg-navy-800 group-open:text-white flex items-center justify-center shrink-0 transition-all duration-200">
              <svg class="w-4 h-4 group-open:rotate-180 transition-transform duration-200" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
              </svg>
            </span>
          </summary>
          <div class="mt-4 pt-4 border-t border-slate-100 text-sm sm:text-base text-slate-600 leading-relaxed">
            {faq.answer}
          </div>
        </details>
      ))}
    </div>

    <!-- Extra Questions Card -->
    <div class="mt-12 p-6 rounded-2xl bg-white border border-slate-200/90 shadow-sm flex flex-col sm:flex-row items-center justify-between gap-4 text-center sm:text-left">
      <div>
        <h3 class="font-bold text-navy-950 text-base">Masih ada pertanyaan lain yang belum terjawab?</h3>
        <p class="text-xs sm:text-sm text-slate-500">Customer service kami siap membantu konsultasi teknis gratis.</p>
      </div>
      <a
        href={faqWaUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 bg-navy-800 hover:bg-navy-900 text-white font-semibold text-xs sm:text-sm px-5 py-2.5 rounded-xl transition-colors shrink-0"
      >
        <span>Tanya Langsung via WA</span>
        <span>&rarr;</span>
      </a>
    </div>
  </div>
</section>
