---
import { pricingList, createWhatsAppLink } from '../config/site';

// Map categories to pricing items for interactive filter
const categories = [
  { id: "all", label: "Semua Layanan" },
  { id: "cuci", label: "Cuci AC" },
  { id: "inverter", label: "AC Inverter" },
  { id: "freon", label: "Isi Freon" },
  { id: "pasang", label: "Bongkar Pasang" },
  { id: "perbaikan", label: "Perbaikan & Overhaul" },
];

const itemsWithCategory = pricingList.map((item) => {
  let cat = "cuci";
  const n = item.name.toLowerCase();
  if (n.includes("inverter")) cat = "inverter";
  else if (n.includes("freon")) cat = "freon";
  else if (n.includes("pasang") || n.includes("bongkar")) cat = "pasang";
  else if (n.includes("bocor") || n.includes("overhaul")) cat = "perbaikan";
  
  return { ...item, category: cat };
});

const consultWaUrl = createWhatsAppLink({
  service: "Konsultasi Seluruh Tarif & Layanan AC",
  notes: "Halo Jawara Teknik, saya ingin tanya estimasi tarif pengerjaan AC untuk rumah/villa.",
});
---

<section id="tarif" class="relative py-16 sm:py-24 lg:py-28 bg-sky-50/70 dark:bg-[#040E1B] border-b border-sky-100/80 dark:border-navy-900 overflow-hidden section-content-visibility">
  
  <!-- Subtle Blueprint Square Grid Background -->
  <div class="absolute inset-0 pointer-events-none select-none overflow-hidden" aria-hidden="true">
    <div class="w-full h-full bg-grid-blueprint dark:bg-grid-blueprint-dark [mask-image:radial-gradient(ellipse_75%_65%_at_50%_50%,black_35%,transparent_100%)]"></div>
  </div>

  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header (Title left-aligned matching sample/layout.png) -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-10 sm:mb-12 reveal-on-scroll">
      <div>
        <div class="inline-flex items-center gap-1.5 px-3.5 py-1 rounded-full bg-iceblue-100 dark:bg-iceblue-500/20 text-iceblue-900 dark:text-iceblue-300 text-xs font-semibold mb-3 border border-iceblue-200 dark:border-iceblue-400/30 shadow-2xs">
          <!-- Lucide Wrench -->
          <svg class="w-3.5 h-3.5 text-iceblue-700 dark:text-iceblue-300 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"></path>
          </svg>
          <span data-i18n="pricing.badge">Layanan Spesialis AC Panggilan Bali</span>
        </div>
        <h2 class="text-2xl sm:text-4xl font-extrabold text-navy-950 dark:text-white tracking-tight" data-i18n="pricing.title">
          Katalog Layanan & Penanganan AC Bali
        </h2>
        <p class="mt-2 text-sm sm:text-base text-slate-600 dark:text-slate-300 hidden sm:block" data-i18n="pricing.desc">
          Pilihan servis cuci, perawatan inverter, isi freon, dan perbaikan terpercaya untuk hunian, villa, dan kantor Anda.
        </p>
      </div>

      <!-- Right Action Pill Button (matching sample/layout.png) -->
      <a
        href={consultWaUrl}
        target="_blank"
        rel="noopener noreferrer"
        data-open-modal
        data-service="Konsultasi Seluruh Tarif & Layanan AC"
        class="hidden sm:inline-flex items-center justify-center gap-2 bg-slate-100 hover:bg-slate-200 dark:bg-navy-900 dark:hover:bg-navy-800 text-navy-950 dark:text-white font-semibold text-xs sm:text-sm px-5 py-2.5 rounded-full border border-slate-200/90 dark:border-navy-700/80 transition-all duration-200 self-start md:self-auto shrink-0 cursor-pointer"
      >
        <span data-i18n="pricing.view_all">Lihat Semua Estimasi</span>
        <!-- Lucide ArrowRight -->
        <svg class="w-3.5 h-3.5 text-slate-500 dark:text-slate-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M5 12h14"></path>
          <path d="m12 5 7 7-7 7"></path>
        </svg>
      </a>
    </div>

    <!-- Filter Category Pills (Matching sample/layout.png 'Popular, USA, Europe...') -->
    <div class="flex items-center gap-2.5 overflow-x-auto pb-4 mb-8 sm:mb-10 no-scrollbar" id="pricing-filters">
      {categories.map((cat, idx) => (
        <button
          type="button"
          data-category={cat.id}
          data-i18n={`pricing.filter_${cat.id}`}
          class={`filter-pill-btn px-4 py-2 rounded-full text-xs sm:text-sm font-semibold whitespace-nowrap transition-all duration-200 cursor-pointer ${
            idx === 0
              ? 'bg-navy-950 dark:bg-iceblue-600 text-white shadow-xs'
              : 'bg-slate-100/90 dark:bg-navy-900/80 text-slate-600 dark:text-slate-300 hover:bg-slate-200/80 dark:hover:bg-navy-800 hover:text-navy-950 dark:hover:text-white'
          }`}
        >
          {cat.label}
        </button>
      ))}
    </div>

    <!-- 4-Card Horizontal Grid with Spacious Mobile/Desktop Gap -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5 sm:gap-6 lg:gap-7" id="pricing-grid">
      {itemsWithCategory.map((item, idx) => {
        const orderUrl = createWhatsAppLink({
          service: item.serviceQuery,
          notes: `Estimasi Tarif: ${item.price} ${item.unit}`,
        });

        return (
          <article
            data-cat={item.category}
            data-reveal-delay={(idx % 4) * 80}
            class="pricing-item glass-apple-card rounded-2xl p-4 sm:p-5 flex flex-col justify-between group reveal-on-scroll"
          >
            <div>
              <!-- Rounded-XL Image Preview -->
              <div class="relative w-full h-48 sm:h-52 rounded-xl overflow-hidden bg-slate-100 dark:bg-navy-900 mb-4">
                <img
                  src={item.image}
                  alt={item.imageAlt}
                  class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-300"
                  loading="lazy"
                  decoding="async"
                  width="400"
                  height="240"
                />
                <div class="absolute top-3 left-3 bg-navy-950/85 backdrop-blur-xs text-white text-xs font-bold px-3 py-1 rounded-full shadow-2xs" data-i18n={`pricing.item_${idx}_badge`}>
                  {item.badge}
                </div>
              </div>

              <!-- Content Below Image with Clean Breathing Room -->
              <div class="px-1 pb-2">
                <h3 class="font-bold text-base sm:text-lg text-navy-950 dark:text-white group-hover:text-iceblue-700 dark:group-hover:text-iceblue-400 transition-colors line-clamp-1 mb-2" data-i18n={`pricing.item_${idx}_name`}>
                  {item.name}
                </h3>
                <div class="flex items-center gap-2 mb-3">
                  <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-iceblue-50 dark:bg-iceblue-500/15 border border-iceblue-200/80 dark:border-iceblue-400/30 text-iceblue-800 dark:text-iceblue-300 text-xs font-bold shadow-2xs">
                    <!-- Lucide MessageCircle -->
                    <svg class="w-3.5 h-3.5 text-iceblue-600 dark:text-iceblue-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"></path>
                    </svg>
                    <span data-i18n="pricing.price_consultation">Konsultasi Tarif via Chat</span>
                  </span>
                  <span class="text-xs text-slate-400 dark:text-slate-500 font-medium hidden sm:inline" data-i18n={`pricing.item_${idx}_unit`}>{item.unit}</span>
                </div>
                <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 line-clamp-2 leading-relaxed mb-4" data-i18n={`pricing.item_${idx}_desc`}>
                  {item.description}
                </p>
              </div>
            </div>

            <!-- Bottom Pill Order Button -->
            <div class="pt-2 px-1 pb-1">
              <a
                href={orderUrl}
                target="_blank"
                rel="noopener noreferrer"
                data-open-modal
                data-service={item.name}
                class="w-full inline-flex items-center justify-center gap-2 bg-navy-50 dark:bg-navy-900 group-hover:bg-navy-950 dark:group-hover:bg-iceblue-600 text-navy-900 dark:text-slate-200 group-hover:text-white font-bold text-xs sm:text-sm py-2.5 px-4 rounded-full transition-all duration-200 cursor-pointer"
              >
                <!-- Lucide MessageCircle -->
                <svg class="w-3.5 h-3.5 text-emerald-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"></path>
                </svg>
                <span data-i18n="pricing.btn_book">Tanya Estimasi via WA</span>
              </a>
            </div>
          </article>
        );
      })}
    </div>
  </div>
</section>

<!-- Client-side Interactive Filter Script (Instant smooth category filtering) -->
<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const filterButtons = document.querySelectorAll('.filter-pill-btn');
    const pricingItems = document.querySelectorAll('.pricing-item');

    filterButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const cat = btn.getAttribute('data-category');

        // Update active button styling
        filterButtons.forEach((b) => {
          b.classList.remove('bg-navy-950', 'dark:bg-iceblue-600', 'text-white', 'shadow-xs');
          b.classList.add('bg-slate-100/90', 'dark:bg-navy-900/80', 'text-slate-600', 'dark:text-slate-300');
        });
        btn.classList.add('bg-navy-950', 'dark:bg-iceblue-600', 'text-white', 'shadow-xs');
        btn.classList.remove('bg-slate-100/90', 'dark:bg-navy-900/80', 'text-slate-600', 'dark:text-slate-300');

        // Filter cards smoothly
        pricingItems.forEach((item) => {
          const itemCat = item.getAttribute('data-cat');
          if (cat === 'all' || itemCat === cat) {
            item.style.display = 'flex';
          } else {
            item.style.display = 'none';
          }
        });
      });
    });
  });
</script>
