---
import { pricingList, technicalPricingList, createWhatsAppLink } from '../config/site';

// Map categories to pricing items for interactive filter
const categories = [
  { id: "all", label: "Semua Layanan" },
  { id: "cuci", label: "Cuci AC" },
  { id: "inverter", label: "AC Inverter" },
  { id: "freon", label: "Isi Freon" },
  { id: "pasang", label: "Bongkar Pasang" },
  { id: "perbaikan", label: "Perbaikan & Overhaul" },
];

const itemsWithCategory = pricingList.map((item) => {
  let cat = "cuci";
  const n = item.name.toLowerCase();
  if (n.includes("inverter")) cat = "inverter";
  else if (n.includes("freon")) cat = "freon";
  else if (n.includes("pasang") || n.includes("bongkar")) cat = "pasang";
  else if (n.includes("bocor") || n.includes("overhaul")) cat = "perbaikan";
  
  return { ...item, category: cat };
});

const consultWaUrl = createWhatsAppLink({
  service: "Konsultasi Seluruh Tarif & Layanan AC",
  notes: "Halo Jawara Teknik, saya ingin tanya estimasi tarif pengerjaan AC untuk rumah/villa.",
});
---

<section id="tarif" class="relative py-16 sm:py-24 bg-white border-b border-slate-200/70 overflow-hidden section-content-visibility">
  
  <!-- Subtle Blueprint Square Grid Background -->
  <div class="absolute inset-0 pointer-events-none select-none overflow-hidden" aria-hidden="true">
    <div class="w-full h-full bg-grid-blueprint [mask-image:radial-gradient(ellipse_75%_65%_at_50%_50%,black_35%,transparent_100%)]"></div>
  </div>

  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header (Title left-aligned matching sample/layout.png) -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-8 reveal-on-scroll">
      <div>
        <div class="inline-flex items-center gap-1.5 px-3.5 py-1 rounded-full bg-emerald-50 text-emerald-800 text-xs font-semibold mb-3 border border-emerald-200/80">
          <!-- Lucide ShieldCheck -->
          <svg class="w-3.5 h-3.5 text-emerald-600 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
            <path d="m9 12 2 2 4-4"></path>
          </svg>
          <span data-i18n="pricing.badge">Pasti & Transparan di Awal</span>
        </div>
        <h2 class="text-2xl sm:text-4xl font-extrabold text-navy-950 tracking-tight" data-i18n="pricing.title">
          Layanan Utama & Pilihan Tarif di Bali
        </h2>
        <p class="mt-2 text-sm sm:text-base text-slate-600" data-i18n="pricing.desc">
          Estimasi tarif pasti tanpa biaya tersembunyi. Bergaransi 30 hari penuh di seluruh wilayah Bali.
        </p>
      </div>

      <!-- Right Action Pill Button (matching sample/layout.png) -->
      <a
        href={consultWaUrl}
        target="_blank"
        rel="noopener noreferrer"
        data-open-modal
        data-service="Konsultasi Seluruh Tarif & Layanan AC"
        class="hidden sm:inline-flex items-center justify-center gap-2 bg-slate-100 hover:bg-slate-200 text-navy-950 font-semibold text-xs sm:text-sm px-5 py-2.5 rounded-full border border-slate-200/90 transition-all duration-200 self-start md:self-auto shrink-0 cursor-pointer"
      >
        <span data-i18n="pricing.view_all">Lihat Semua Estimasi</span>
        <!-- Lucide ArrowRight -->
        <svg class="w-3.5 h-3.5 text-slate-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M5 12h14"></path>
          <path d="m12 5 7 7-7 7"></path>
        </svg>
      </a>
    </div>

    <!-- Filter Category Pills (Matching sample/layout.png 'Popular, USA, Europe...') -->
    <div class="flex items-center gap-2 overflow-x-auto pb-3 mb-8 no-scrollbar" id="pricing-filters">
      {categories.map((cat, idx) => (
        <button
          type="button"
          data-category={cat.id}
          data-i18n={`pricing.filter_${cat.id}`}
          class={`filter-pill-btn px-4 py-2 rounded-full text-xs sm:text-sm font-semibold whitespace-nowrap transition-all duration-200 cursor-pointer ${
            idx === 0
              ? 'bg-navy-950 text-white shadow-xs'
              : 'bg-slate-100/90 text-slate-600 hover:bg-slate-200/80 hover:text-navy-950'
          }`}
        >
          {cat.label}
        </button>
      ))}
    </div>

    <!-- 4-Card Horizontal Grid (Matching sample/layout.png Top Destinations) -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 mb-12" id="pricing-grid">
      {itemsWithCategory.map((item, idx) => {
        const orderUrl = createWhatsAppLink({
          service: item.serviceQuery,
          notes: `Estimasi Tarif: ${item.price} ${item.unit}`,
        });

        return (
          <article
            data-cat={item.category}
            data-reveal-delay={(idx % 4) * 80}
            class="pricing-item glass-apple-card rounded-xl p-3 sm:p-3.5 flex flex-col justify-between group reveal-on-scroll"
          >
            <div>
              <!-- Rounded-LG Image Preview -->
              <div class="relative w-full h-48 sm:h-52 rounded-lg overflow-hidden bg-slate-100 mb-4">
                <img
                  src={item.image}
                  alt={item.imageAlt}
                  class="w-full h-full object-cover object-center"
                  loading="lazy"
                  decoding="async"
                  width="400"
                  height="240"
                />
                <div class="absolute top-3 left-3 bg-navy-950/85 backdrop-blur-xs text-white text-xs font-bold px-3 py-1 rounded-full shadow-2xs" data-i18n={`pricing.item_${idx}_badge`}>
                  {item.badge}
                </div>
              </div>

              <!-- Content Below Image -->
              <div class="px-1.5 pb-2">
                <h3 class="font-bold text-base text-navy-950 group-hover:text-iceblue-700 transition-colors line-clamp-1 mb-1" data-i18n={`pricing.item_${idx}_name`}>
                  {item.name}
                </h3>
                <div class="flex items-baseline gap-1.5 mb-2">
                  <span class="text-lg font-black text-navy-950 tracking-tight tabular-nums">{item.price}</span>
                  <span class="text-xs text-slate-500 font-medium" data-i18n={`pricing.item_${idx}_unit`}>{item.unit}</span>
                </div>
                <p class="text-xs text-slate-600 line-clamp-2 leading-relaxed mb-4" data-i18n={`pricing.item_${idx}_desc`}>
                  {item.description}
                </p>
              </div>
            </div>

            <!-- Bottom Pill Order Button -->
            <div class="px-1.5 pb-1">
              <a
                href={orderUrl}
                target="_blank"
                rel="noopener noreferrer"
                data-open-modal
                data-service={item.name}
                class="w-full inline-flex items-center justify-center gap-2 bg-navy-50 group-hover:bg-navy-950 text-navy-900 group-hover:text-white font-bold text-xs sm:text-sm py-2.5 px-4 rounded-full transition-all duration-200 cursor-pointer"
              >
                <!-- Lucide MessageCircle -->
                <svg class="w-3.5 h-3.5 text-emerald-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"></path>
                </svg>
                <span data-i18n="pricing.btn_book">Pesan Layanan</span>
              </a>
            </div>
          </article>
        );
      })}
    </div>

    <!-- Technical & Sparepart Pricing Table (Accordion/Structured Glass Layout) -->
    <div class="mb-12 glass-apple-card rounded-xl p-5 sm:p-7 overflow-hidden border border-slate-200/90 shadow-xs reveal-on-scroll">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6 pb-4 border-b border-slate-100">
        <div>
          <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-navy-50 text-navy-900 text-xs font-semibold mb-2 border border-navy-200/70">
            <!-- Lucide Wrench -->
            <svg class="w-3.5 h-3.5 text-navy-800" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"></path>
            </svg>
            <span data-i18n="pricing.tech_badge">Daftar Harga Jasa Teknis & Sparepart</span>
          </div>
          <h3 class="text-lg sm:text-xl font-extrabold text-navy-950" data-i18n="pricing.tech_title">
            Rincian Biaya Tindakan Teknis Tambahan
          </h3>
          <p class="text-xs sm:text-sm text-slate-500 mt-1" data-i18n="pricing.tech_desc">
            Transparansi tarif tindakan teknisi di lokasi. Disetujui bersama sebelum pengerjaan dimulai.
          </p>
        </div>
        <span class="inline-flex items-center gap-1.5 text-xs font-bold text-emerald-700 bg-emerald-50 px-3 py-1.5 rounded-full border border-emerald-200 self-start sm:self-auto" data-i18n="pricing.tech_warranty">
          ✓ Garansi Pengerjaan 30 Hari
        </span>
      </div>

      <!-- Responsive Table / List -->
      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs sm:text-sm border-collapse">
          <thead>
            <tr class="border-b border-slate-200/80 text-slate-500 text-xs uppercase tracking-wider">
              <th class="py-3 px-3" data-i18n="pricing.col_service">Jenis Tindakan / Layanan</th>
              <th class="py-3 px-3" data-i18n="pricing.col_cat">Kategori</th>
              <th class="py-3 px-3" data-i18n="pricing.col_price">Tarif Resmi</th>
              <th class="py-3 px-3 text-right" data-i18n="pricing.col_action">Aksi</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            {technicalPricingList.map((tech, idx) => {
              const techWaUrl = createWhatsAppLink({
                service: `${tech.name} (${tech.price} ${tech.unit})`,
                notes: tech.description,
              });

              return (
                <tr class="hover:bg-slate-50/70 transition-colors group/row">
                  <td class="py-3.5 px-3">
                    <div class="font-bold text-navy-950" data-i18n={`pricing.tech_${idx}_name`}>{tech.name}</div>
                    <div class="text-xs text-slate-500 mt-0.5" data-i18n={`pricing.tech_${idx}_desc`}>{tech.description}</div>
                  </td>
                  <td class="py-3.5 px-3 whitespace-nowrap">
                    <span class="inline-block px-3 py-1 rounded-full bg-slate-100 text-slate-700 text-xs font-semibold" data-i18n={`pricing.tech_${idx}_cat`}>
                      {tech.category}
                    </span>
                  </td>
                  <td class="py-3.5 px-3 whitespace-nowrap">
                    <div class="font-black text-navy-950 tabular-nums">{tech.price}</div>
                    <div class="text-xs text-slate-500" data-i18n={`pricing.tech_${idx}_unit`}>{tech.unit}</div>
                  </td>
                  <td class="py-3.5 px-3 text-right whitespace-nowrap">
                    <a
                      href={techWaUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      data-open-modal
                      data-service={tech.name}
                      class="inline-flex items-center gap-1.5 bg-slate-100 hover:bg-navy-950 hover:text-white text-navy-900 font-bold text-xs px-3.5 py-1.5 rounded-full border border-slate-200 transition-all duration-200 cursor-pointer"
                    >
                      <span data-i18n="pricing.btn_order_short">Pesan</span>
                      <svg class="w-3 h-3 text-emerald-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <path d="m9 18 6-6-6-6"></path>
                      </svg>
                    </a>
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    </div>

    <!-- Assurance Notice Banner (Clean Corporate Layout) -->
    <div class="glass-apple-dark rounded-xl p-6 sm:p-8 flex flex-col md:flex-row items-center justify-between gap-6 shadow-sm">
      <div class="flex items-start gap-4">
        <div class="w-11 h-11 rounded-xl bg-iceblue-500/20 text-iceblue-400 border border-iceblue-400/20 flex items-center justify-center shrink-0">
          <!-- Lucide ShieldCheck -->
          <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
            <path d="m9 12 2 2 4-4"></path>
          </svg>
        </div>
        <div>
          <h3 class="font-bold text-base text-white" data-i18n="pricing.guarantee_title">Komitmen Tarif Jujur & Garansi 30 Hari</h3>
          <p class="text-xs sm:text-sm text-slate-300 mt-1 max-w-2xl" data-i18n="pricing.guarantee_desc">
            Semua biaya pengerjaan disepakati di awal tanpa biaya tersembunyi. Setiap tindakan servis bergaransi resmi selama 30 hari penuh demi kepuasan Anda.
          </p>
        </div>
      </div>
      <div class="shrink-0 w-full md:w-auto">
        <a
          href={createWhatsAppLink({ service: "Konsultasi Estimasi Biaya & Booking" })}
          target="_blank"
          rel="noopener noreferrer"
          class="group/cta w-full md:w-auto inline-flex items-center justify-center gap-2.5 btn-cta-whatsapp text-slate-950 px-6 py-3 rounded-xl text-sm font-bold shadow-md"
        >
          <!-- Official Lucide MessageCircle -->
          <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"></path>
          </svg>
          <span>Tanya Admin via WA</span>
          <!-- Smooth sliding arrow -->
          <svg class="w-4 h-4 shrink-0 transform group-hover/cta:translate-x-1 transition-transform duration-200" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 12h14"></path>
            <path d="m12 5 7 7-7 7"></path>
          </svg>
        </a>
      </div>
    </div>
  </div>
</section>

<!-- Client-side Interactive Filter Script (Instant smooth category filtering) -->
<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const filterButtons = document.querySelectorAll('.filter-pill-btn');
    const pricingItems = document.querySelectorAll('.pricing-item');

    filterButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const cat = btn.getAttribute('data-category');

        // Update active button styling
        filterButtons.forEach((b) => {
          b.classList.remove('bg-navy-950', 'text-white', 'shadow-xs');
          b.classList.add('bg-slate-100/90', 'text-slate-600');
        });
        btn.classList.add('bg-navy-950', 'text-white', 'shadow-xs');
        btn.classList.remove('bg-slate-100/90', 'text-slate-600');

        // Filter cards smoothly
        pricingItems.forEach((item) => {
          const itemCat = item.getAttribute('data-cat');
          if (cat === 'all' || itemCat === cat) {
            item.style.display = 'flex';
          } else {
            item.style.display = 'none';
          }
        });
      });
    });
  });
</script>
