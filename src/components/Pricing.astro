---
import { pricingList, createWhatsAppLink } from '../config/site';
---

<section id="tarif" class="relative py-16 sm:py-24 bg-white border-b border-slate-200/70 overflow-hidden">
  <!-- Subtle Ambient Background Watermarks (Snowflakes & Flow Vectors) -->
  <div class="absolute inset-0 pointer-events-none select-none overflow-hidden" aria-hidden="true">
    <!-- Top-Right Snowflake Watermark -->
    <svg class="absolute -top-12 -right-12 w-96 h-96 text-iceblue-500/[0.035]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round">
      <line x1="2" x2="22" y1="12" y2="12"></line>
      <line x1="12" x2="12" y1="2" y2="22"></line>
      <path d="m20 16-4-4 4-4"></path>
      <path d="m4 8 4 4-4 4"></path>
      <path d="m16 4-4 4-4-4"></path>
      <path d="m8 20 4-4 4 4"></path>
    </svg>
    <!-- Mid-Left Subtle Snowflake Watermark -->
    <svg class="absolute top-1/3 -left-16 w-80 h-80 text-navy-900/[0.025]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round">
      <line x1="2" x2="22" y1="12" y2="12"></line>
      <line x1="12" x2="12" y1="2" y2="22"></line>
      <path d="m20 16-4-4 4-4"></path>
      <path d="m4 8 4 4-4 4"></path>
      <path d="m16 4-4 4-4-4"></path>
      <path d="m8 20 4-4 4 4"></path>
    </svg>
    <!-- Bottom-Right Breeze Flow Curve -->
    <svg class="absolute -bottom-10 -right-10 w-[450px] h-52 text-iceblue-600/[0.03]" viewBox="0 0 450 180" fill="none" stroke="currentColor" stroke-width="1.8">
      <path d="M0 60 Q 120 20 250 70 T 450 70" />
      <path d="M50 110 Q 170 70 300 120 T 450 120" />
    </svg>
  </div>

  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="max-w-3xl mx-auto text-center mb-12 sm:mb-16">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-emerald-50 text-emerald-800 text-xs font-semibold mb-3 border border-emerald-200/60">
        <!-- Lucide ShieldCheck -->
        <svg class="w-3.5 h-3.5 text-emerald-600 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
          <path d="m9 12 2 2 4-4"></path>
        </svg>
        <span>Tanpa Biaya Tersembunyi</span>
      </div>
      <h2 class="text-2xl sm:text-4xl font-extrabold text-navy-950 tracking-tight">
        Daftar Tarif Servis AC di Bali (Pasti & Transparan)
      </h2>
      <p class="mt-3.5 text-base text-slate-600">
        Dokumentasi pengerjaan & estimasi biaya disepakati di awal sebelum pengerjaan. Bergaransi 30 hari penuh.
      </p>
    </div>

    <!-- Pricing Cards Grid with Clean Photographic Showcase -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-7 mb-12">
      {pricingList.map((item) => {
        const orderUrl = createWhatsAppLink({
          service: item.serviceQuery,
          notes: `Estimasi Tarif: ${item.price} ${item.unit}`,
        });

        return (
          <article class={`bg-white rounded-2xl border overflow-hidden shadow-xs card-clean-hover flex flex-col justify-between ${
            item.highlight
              ? 'border-2 border-iceblue-500 ring-2 ring-iceblue-100'
              : 'border-slate-200/90'
          }`}>
            
            <div>
              <!-- Photo Preview on Card Top -->
              <div class="relative w-full h-48 overflow-hidden bg-slate-100">
                <img
                  src={item.image}
                  alt={item.imageAlt}
                  class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-500 ease-out"
                  loading="lazy"
                  decoding="async"
                  width="400"
                  height="240"
                />

                {item.highlight && (
                  <div class="absolute top-3 right-3 bg-iceblue-600 text-white text-[10px] font-bold uppercase tracking-wider px-2.5 py-1 rounded-full shadow-xs">
                    {item.badge}
                  </div>
                )}
              </div>

              <!-- Content Body -->
              <div class="p-6">
                <div class="flex items-center justify-between gap-2 mb-2">
                  <span class={`text-[11px] font-semibold px-2.5 py-0.5 rounded-md ${
                    item.highlight ? 'bg-iceblue-50 text-iceblue-700' : 'bg-slate-100 text-slate-700'
                  }`}>
                    {item.badge}
                  </span>
                  <span class="text-xs text-slate-400 font-medium">Garansi 30 Hari</span>
                </div>

                <h3 class="text-base font-bold text-navy-950 mb-2">{item.name}</h3>
                <p class="text-xs text-slate-500 mb-4 leading-relaxed line-clamp-2">
                  {item.description}
                </p>

                <div class="mb-2 pt-3 border-t border-slate-100">
                  <span class="text-2xl font-extrabold text-navy-950 tracking-tight">{item.price}</span>
                  <span class="text-xs text-slate-500 ml-1 font-medium">{item.unit}</span>
                </div>
              </div>
            </div>

            <!-- WhatsApp Action Button -->
            <div class="p-6 pt-0">
              <a
                href={orderUrl}
                target="_blank"
                rel="noopener noreferrer"
                class={`group/btn w-full inline-flex items-center justify-center gap-2 font-bold text-xs sm:text-sm py-3 px-4 rounded-xl transition-all duration-200 ${
                  item.highlight
                    ? 'btn-cta-whatsapp text-slate-950'
                    : 'bg-navy-900 hover:bg-navy-950 text-white shadow-xs hover:shadow-md'
                }`}
              >
                <!-- Official Lucide MessageCircle -->
                <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"></path>
                </svg>
                <span>Pesan Servis Ini</span>
              </a>
            </div>
          </article>
        );
      })}
    </div>

    <!-- Assurance Notice Banner (Clean Corporate Layout) -->
    <div class="bg-navy-950 text-white rounded-3xl p-6 sm:p-8 flex flex-col md:flex-row items-center justify-between gap-6 shadow-sm border border-navy-800">
      <div class="flex items-start gap-4">
        <div class="w-11 h-11 rounded-xl bg-iceblue-500/20 text-iceblue-400 border border-iceblue-400/20 flex items-center justify-center shrink-0">
          <!-- Lucide ShieldCheck -->
          <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
            <path d="m9 12 2 2 4-4"></path>
          </svg>
        </div>
        <div>
          <h3 class="font-bold text-base text-white">Komitmen Tarif Jujur & Garansi 30 Hari</h3>
          <p class="text-xs sm:text-sm text-slate-300 mt-1 max-w-2xl">
            Biaya diagnosa Rp 60.000 <strong>GRATIS</strong> jika pengerjaan servis dilanjutkan. Setiap servis dilengkapi nota resmi yang berlaku sebagai kartu garansi 30 hari.
          </p>
        </div>
      </div>
      <div class="shrink-0 w-full md:w-auto">
        <a
          href={createWhatsAppLink({ service: "Konsultasi Estimasi Biaya & Booking" })}
          target="_blank"
          rel="noopener noreferrer"
          class="group/cta w-full md:w-auto inline-flex items-center justify-center gap-2.5 btn-cta-whatsapp text-slate-950 px-6 py-3 rounded-xl text-sm font-bold shadow-md"
        >
          <!-- Official Lucide MessageCircle -->
          <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"></path>
          </svg>
          <span>Tanya Admin via WA</span>
          <!-- Smooth sliding arrow -->
          <svg class="w-4 h-4 shrink-0 transform group-hover/cta:translate-x-1 transition-transform duration-200" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 12h14"></path>
            <path d="m12 5 7 7-7 7"></path>
          </svg>
        </a>
      </div>
    </div>
  </div>
</section>
