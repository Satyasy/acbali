---
import { pricingList, createWhatsAppLink } from '../config/site';
---

<section id="tarif" class="py-16 sm:py-24 bg-white border-b border-slate-200/60">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="max-w-3xl mx-auto text-center mb-12 sm:mb-16">
      <div class="inline-flex items-center gap-1.5 px-3.5 py-1 rounded-full bg-emerald-50 text-emerald-800 text-xs font-semibold mb-3 border border-emerald-200/60">
        <!-- Lucide ShieldCheck -->
        <svg class="w-3.5 h-3.5 text-emerald-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <span>Tanpa Biaya Tersembunyi</span>
      </div>
      <h2 class="text-2xl sm:text-4xl font-extrabold text-navy-950 tracking-tight">
        Daftar Tarif Servis AC di Bali (Pasti & Transparan)
      </h2>
      <p class="mt-3.5 text-base text-slate-600">
        Foto pengerjaan riil & estimasi tarif disepakati di awal sebelum teknisi bekerja. Bergaransi 30 hari penuh.
      </p>
    </div>

    <!-- Pricing Cards Grid with Rich Stock Photos -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-7 mb-12">
      {pricingList.map((item) => {
        const orderUrl = createWhatsAppLink({
          service: item.serviceQuery,
          notes: `Estimasi Tarif: ${item.price} ${item.unit}`,
        });

        return (
          <article class={`relative bg-white rounded-2xl border overflow-hidden shadow-sm glass-bubble-hover flex flex-col justify-between transition-all duration-300 ${
            item.highlight
              ? 'border-2 border-iceblue-500 shadow-md ring-4 ring-iceblue-50/70'
              : 'border-slate-200/90'
          }`}>
            
            <div>
              <!-- Photo Preview on Card Top -->
              <div class="relative w-full h-44 overflow-hidden bg-slate-100">
                <img
                  src={item.image}
                  alt={item.imageAlt}
                  class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-500"
                  loading="lazy"
                  decoding="async"
                  width="400"
                  height="220"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-navy-950/75 via-transparent to-transparent"></div>

                {item.highlight && (
                  <div class="absolute top-3 right-3 bg-gradient-to-r from-navy-800 to-iceblue-600 text-white text-[10px] font-bold uppercase tracking-wider px-3 py-1 rounded-full shadow-md backdrop-blur-md border border-white/20">
                    {item.badge}
                  </div>
                )}

                <div class="absolute bottom-3 left-3 right-3 flex items-center justify-between text-white">
                  <span class="text-xs font-bold truncate drop-shadow">{item.name}</span>
                  <span class="text-[11px] font-semibold text-iceblue-200 drop-shadow">Garansi 30 Hari</span>
                </div>
              </div>

              <!-- Content Body -->
              <div class="p-6">
                <div class="flex items-center justify-between gap-2 mb-2">
                  <span class={`text-[11px] font-semibold px-2.5 py-0.5 rounded-md ${
                    item.highlight ? 'bg-iceblue-100 text-iceblue-800' : 'bg-slate-100 text-slate-700'
                  }`}>
                    {item.badge}
                  </span>
                </div>

                <p class="text-xs text-slate-500 mb-4 leading-relaxed line-clamp-2">
                  {item.description}
                </p>

                <div class="mb-5 pt-3 border-t border-slate-100">
                  <span class="text-2xl font-extrabold text-navy-900 tracking-tight">{item.price}</span>
                  <span class="text-xs text-slate-500 ml-1 font-medium">{item.unit}</span>
                </div>
              </div>
            </div>

            <!-- WhatsApp Action Button -->
            <div class="p-6 pt-0">
              <a
                href={orderUrl}
                target="_blank"
                rel="noopener noreferrer"
                class={`w-full inline-flex items-center justify-center gap-2 font-bold text-xs sm:text-sm py-3 px-4 rounded-xl transition-all duration-200 ${
                  item.highlight
                    ? 'glass-cta-bubble text-slate-950'
                    : 'bg-navy-800 hover:bg-navy-900 text-white hover:scale-[1.02]'
                }`}
              >
                <!-- Lucide MessageSquare / WhatsApp Icon -->
                <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
                  <path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2zm.01 1.67c4.54 0 8.24 3.7 8.24 8.24 0 2.2-.86 4.27-2.42 5.82a8.19 8.19 0 0 1-5.82 2.42c-1.48 0-2.93-.4-4.2-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.2 8.2 0 0 1-1.26-4.38c0-4.54 3.7-8.24 8.24-8.24zm4.5 11.66c-.25-.13-1.47-.72-1.7-.81-.23-.08-.39-.13-.56.13-.17.25-.64.81-.79.97-.14.17-.29.19-.54.06-.25-.13-1.07-.39-2.03-1.25-.75-.67-1.26-1.5-1.4-1.75-.15-.25-.02-.39.11-.51.11-.11.25-.29.38-.44.12-.14.17-.25.25-.42.08-.17.04-.31-.02-.44-.06-.13-.56-1.35-.77-1.85-.2-.49-.41-.42-.56-.43l-.48-.01c-.17 0-.44.06-.67.31-.23.25-.88.86-.88 2.1 0 1.24.9 2.44 1.03 2.61.13.17 1.78 2.71 4.3 3.8 2.52 1.09 2.52.73 2.98.69.45-.05 1.47-.6 1.68-1.18.21-.58.21-1.08.15-1.18-.06-.11-.23-.17-.48-.29z"/>
                </svg>
                <span>Pesan Servis Ini</span>
              </a>
            </div>
          </article>
        );
      })}
    </div>

    <!-- Assurance Notice Banner (Frosted Dark Glass) -->
    <div class="bg-navy-950 text-white rounded-3xl p-6 sm:p-8 flex flex-col md:flex-row items-center justify-between gap-6 shadow-xl border border-white/10">
      <div class="flex items-start gap-4">
        <div class="w-12 h-12 rounded-2xl bg-iceblue-500/20 border border-iceblue-400/30 text-iceblue-300 flex items-center justify-center shrink-0">
          <!-- Lucide BadgeCheck -->
          <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
        </div>
        <div>
          <h3 class="font-bold text-base sm:text-lg text-white">Komitmen Tarif Jujur & Garansi 30 Hari</h3>
          <p class="text-xs sm:text-sm text-slate-300 mt-1 max-w-2xl">
            Biaya diagnosa Rp 60.000 <strong>GRATIS</strong> jika pengerjaan servis dilanjutkan. Setiap servis dilengkapi nota fisik & digital yang berlaku sebagai kartu garansi 30 hari.
          </p>
        </div>
      </div>
      <div class="shrink-0 w-full md:w-auto">
        <a
          href={createWhatsAppLink({ service: "Konsultasi Estimasi Biaya & Booking" })}
          target="_blank"
          rel="noopener noreferrer"
          class="w-full md:w-auto inline-flex items-center justify-center gap-2 glass-cta-bubble text-slate-950 font-extrabold px-6 py-3.5 rounded-xl text-sm"
        >
          <span>Tanya Admin via WA</span>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>
      </div>
    </div>
  </div>
</section>
