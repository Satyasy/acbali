---
import { siteConfig, createWhatsAppLink } from '../config/site';

const emergencyWaUrl = createWhatsAppLink({
  service: "PANGGILAN DARURAT (Respon Cepat 60 Menit)",
  notes: "Urgent / Butuh penanganan segera hari ini",
});
---

<header class="bg-navy-950 text-white text-[11px] sm:text-xs py-1 sm:py-1.5 px-4 sticky top-0 z-40 border-b border-navy-800/80">
  <div class="max-w-7xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-1.5 sm:gap-2">
    <!-- Operational Hours -->
    <div class="flex items-center gap-2 text-center sm:text-left">
      <!-- Lucide Clock -->
      <svg class="w-3.5 h-3.5 text-iceblue-400 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="10"></circle>
        <polyline points="12 6 12 12 16 14"></polyline>
      </svg>
      <span class="text-slate-200 font-medium tracking-wide">
        {siteConfig.operatingHours}
      </span>
    </div>

    <!-- Quick Emergency Action -->
    <div class="flex items-center gap-3">
      <span class="hidden md:inline-flex items-center text-slate-400 text-[11px]">
        <!-- Lucide MapPin -->
        <svg class="w-3.5 h-3.5 mr-1 text-iceblue-400 inline shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"></path>
          <circle cx="12" cy="10" r="3"></circle>
        </svg>
        Teknisi Siaga Denpasar & Badung
      </span>
      
      <a 
        href={emergencyWaUrl}
        target="_blank" 
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1.5 btn-cta-whatsapp text-slate-950 px-3 py-0.5 rounded-full text-[11px] font-bold"
        title="Hubungi Layanan Darurat 60 Menit"
      >
        <!-- Lucide PhoneCall -->
        <svg class="w-3 h-3 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
        </svg>
        <span>{siteConfig.responseTime}</span>
      </a>
    </div>
  </div>
</header>
