---
import { siteConfig, createWhatsAppLink } from '../config/site';

const emergencyWaUrl = createWhatsAppLink({
  service: "PANGGILAN DARURAT (Respon Cepat 60 Menit)",
  notes: "Urgent / Butuh penanganan segera hari ini",
});
---

<header class="bg-navy-950/90 text-white text-xs sm:text-sm py-2.5 px-4 sticky top-0 z-40 shadow-sm border-b border-white/10 backdrop-blur-md">
  <div class="max-w-7xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-2">
    <!-- Schedule & Operational Info -->
    <div class="flex items-center gap-2 text-center sm:text-left">
      <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-emerald-500/20 text-emerald-300 font-semibold text-[11px] border border-emerald-500/30">
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-ping"></span>
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 -ml-2.5"></span>
        Online Siaga
      </span>
      <span class="text-slate-200 font-medium tracking-wide">
        {siteConfig.operatingHours}
      </span>
    </div>

    <!-- Quick Emergency Action -->
    <div class="flex items-center gap-3">
      <span class="hidden md:inline-flex items-center text-slate-300 text-xs font-medium">
        <!-- Lucide Clock -->
        <svg class="w-3.5 h-3.5 mr-1.5 text-iceblue-400 inline" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        Teknisi Siaga Denpasar & Badung
      </span>
      
      <a 
        href={emergencyWaUrl}
        target="_blank" 
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1.5 glass-cta-bubble text-slate-950 font-extrabold px-3.5 py-1 rounded-full text-xs shadow-md transition-transform duration-150 active:scale-95"
        title="Hubungi Layanan Darurat 60 Menit"
      >
        <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
          <path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2zm.01 1.67c4.54 0 8.24 3.7 8.24 8.24 0 2.2-.86 4.27-2.42 5.82a8.19 8.19 0 0 1-5.82 2.42c-1.48 0-2.93-.4-4.2-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.2 8.2 0 0 1-1.26-4.38c0-4.54 3.7-8.24 8.24-8.24zm4.5 11.66c-.25-.13-1.47-.72-1.7-.81-.23-.08-.39-.13-.56.13-.17.25-.64.81-.79.97-.14.17-.29.19-.54.06-.25-.13-1.07-.39-2.03-1.25-.75-.67-1.26-1.5-1.4-1.75-.15-.25-.02-.39.11-.51.11-.11.25-.29.38-.44.12-.14.17-.25.25-.42.08-.17.04-.31-.02-.44-.06-.13-.56-1.35-.77-1.85-.2-.49-.41-.42-.56-.43l-.48-.01c-.17 0-.44.06-.67.31-.23.25-.88.86-.88 2.1 0 1.24.9 2.44 1.03 2.61.13.17 1.78 2.71 4.3 3.8 2.52 1.09 2.52.73 2.98.69.45-.05 1.47-.6 1.68-1.18.21-.58.21-1.08.15-1.18-.06-.11-.23-.17-.48-.29z"/>
        </svg>
        <span>{siteConfig.responseTime}</span>
      </a>
    </div>
  </div>
</header>
