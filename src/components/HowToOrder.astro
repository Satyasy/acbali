---
import { orderingSteps, createWhatsAppLink } from '../config/site';

const stepWaUrl = createWhatsAppLink();
---

<section id="cara-order" class="relative py-16 sm:py-24 bg-white border-b border-slate-200/60 overflow-hidden">
  <!-- Subtle Ambient Architectural Dot-Matrix Background -->
  <div class="absolute inset-0 pointer-events-none select-none overflow-hidden" aria-hidden="true">
    <div class="w-full h-full bg-dot-matrix [mask-image:radial-gradient(ellipse_60%_50%_at_50%_50%,black_40%,transparent_100%)] opacity-75"></div>
  </div>


  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="max-w-3xl mx-auto text-center mb-12 sm:mb-16">
      <div class="inline-flex items-center gap-1.5 px-3.5 py-1 rounded-full bg-navy-100 text-navy-900 text-xs font-semibold mb-3 border border-navy-200/60">
        <!-- Lucide ListOrdered -->
        <svg class="w-3.5 h-3.5 text-navy-800" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4" />
        </svg>
        <span>Alur Pemesanan Cepat</span>
      </div>
      <h2 class="text-2xl sm:text-4xl font-extrabold text-navy-950 tracking-tight">
        3 Langkah Praktis Memanggil Teknisi Jawara Teknik
      </h2>
      <p class="mt-3.5 text-base text-slate-600">
        Tanpa perlu unduh aplikasi atau registrasi rumit. Cukup beberapa ketukan di WhatsApp.
      </p>
    </div>

    <!-- Steps Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 relative">
      {orderingSteps.map((item, index) => (
        <article class="group relative bg-slatewhite rounded-3xl p-8 border border-slate-200/90 shadow-sm hover:shadow-xl hover:-translate-y-1.5 transition-all duration-300 flex flex-col justify-between">
          <div>
            <!-- Number badge -->
            <div class="flex items-center justify-between mb-6">
              <span class="text-5xl font-black text-navy-700 tracking-tighter">
                {item.step}
              </span>
              <span class="inline-flex items-center gap-1 px-3 py-1 rounded-full bg-navy-900 text-white text-[11px] font-bold">
                {index === 0 && 'Mulai Disini'}
                {index === 1 && 'Proses Kilat'}
                {index === 2 && 'Selesai & Bergaransi'}
              </span>
            </div>

            <h3 class="text-lg font-bold text-navy-950 mb-3 leading-snug">
              {item.title}
            </h3>

            <p class="text-sm text-slate-600 leading-relaxed">
              {item.description}
            </p>
          </div>

          <div class="mt-8 pt-4 border-t border-slate-200/70 flex items-center justify-between text-xs text-navy-900 font-semibold">
            <span class="text-iceblue-700 font-bold">{item.actionText}</span>
            <!-- Official Lucide ArrowRight with smooth glide -->
            <svg class="w-4 h-4 text-slate-400 group-hover:text-navy-950 transform group-hover:translate-x-1.5 transition-all duration-300 ease-out" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M5 12h14"></path>
              <path d="m12 5 7 7-7 7"></path>
            </svg>
          </div>
        </article>
      ))}
    </div>

    <!-- Bottom CTA Button -->
    <div class="mt-14 text-center">
      <a
        href={stepWaUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="group/order inline-flex items-center justify-center gap-2.5 btn-cta-whatsapp text-slate-950 font-bold text-sm sm:text-base px-8 py-4 rounded-2xl shadow-xl"
      >
        <!-- Official Lucide MessageCircle -->
        <svg class="w-5 h-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"></path>
        </svg>
        <span>Pesan Sekarang via WhatsApp (Respon 60 Menit)</span>
        <svg class="w-4 h-4 shrink-0 transform group-hover/order:translate-x-1.5 transition-transform duration-200 ease-out" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M5 12h14"></path>
          <path d="m12 5 7 7-7 7"></path>
        </svg>
      </a>
    </div>
  </div>
</section>
