---
import { orderingSteps, createWhatsAppLink } from '../config/site';

const stepWaUrl = createWhatsAppLink();
---

<section id="cara-order" class="py-16 sm:py-24 bg-white border-b border-slate-200/60">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="max-w-3xl mx-auto text-center mb-12 sm:mb-16">
      <div class="inline-flex items-center gap-1.5 px-3.5 py-1 rounded-full bg-navy-100 text-navy-900 text-xs font-semibold mb-3 border border-navy-200/60">
        <!-- Lucide ListOrdered -->
        <svg class="w-3.5 h-3.5 text-navy-800" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4" />
        </svg>
        <span>Alur Pemesanan Cepat</span>
      </div>
      <h2 class="text-2xl sm:text-4xl font-extrabold text-navy-950 tracking-tight">
        3 Langkah Praktis Memanggil Teknisi Jawara Teknik
      </h2>
      <p class="mt-3.5 text-base text-slate-600">
        Tanpa perlu unduh aplikasi atau registrasi rumit. Cukup beberapa ketukan di WhatsApp.
      </p>
    </div>

    <!-- Steps Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 relative">
      {orderingSteps.map((item, index) => (
        <article class="relative bg-slatewhite rounded-3xl p-8 border border-slate-200/90 shadow-sm glass-bubble-hover flex flex-col justify-between">
          <div>
            <!-- Number badge -->
            <div class="flex items-center justify-between mb-6">
              <span class="text-5xl font-black text-navy-200 tracking-tighter">
                {item.step}
              </span>
              <span class="inline-flex items-center gap-1 px-3 py-1 rounded-full bg-navy-900 text-white text-[11px] font-bold">
                {index === 0 && 'Mulai Disini'}
                {index === 1 && 'Proses Kilat'}
                {index === 2 && 'Selesai & Bergaransi'}
              </span>
            </div>

            <h3 class="text-lg font-bold text-navy-950 mb-3 leading-snug">
              {item.title}
            </h3>

            <p class="text-sm text-slate-600 leading-relaxed">
              {item.description}
            </p>
          </div>

          <div class="mt-8 pt-4 border-t border-slate-200/70 flex items-center justify-between text-xs text-navy-900 font-semibold">
            <span class="text-iceblue-600 font-bold">{item.actionText}</span>
            <!-- Lucide ArrowRight -->
            <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </div>
        </article>
      ))}
    </div>

    <!-- Bottom CTA Button -->
    <div class="mt-14 text-center">
      <a
        href={stepWaUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center gap-3 glass-cta-bubble text-slate-950 font-extrabold text-base px-9 py-4 rounded-2xl shadow-xl"
      >
        <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
          <path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2zm.01 1.67c4.54 0 8.24 3.7 8.24 8.24 0 2.2-.86 4.27-2.42 5.82a8.19 8.19 0 0 1-5.82 2.42c-1.48 0-2.93-.4-4.2-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.2 8.2 0 0 1-1.26-4.38c0-4.54 3.7-8.24 8.24-8.24zm4.5 11.66c-.25-.13-1.47-.72-1.7-.81-.23-.08-.39-.13-.56.13-.17.25-.64.81-.79.97-.14.17-.29.19-.54.06-.25-.13-1.07-.39-2.03-1.25-.75-.67-1.26-1.5-1.4-1.75-.15-.25-.02-.39.11-.51.11-.11.25-.29.38-.44.12-.14.17-.25.25-.42.08-.17.04-.31-.02-.44-.06-.13-.56-1.35-.77-1.85-.2-.49-.41-.42-.56-.43l-.48-.01c-.17 0-.44.06-.67.31-.23.25-.88.86-.88 2.1 0 1.24.9 2.44 1.03 2.61.13.17 1.78 2.71 4.3 3.8 2.52 1.09 2.52.73 2.98.69.45-.05 1.47-.6 1.68-1.18.21-.58.21-1.08.15-1.18-.06-.11-.23-.17-.48-.29z"/>
        </svg>
        <span>Pesan Sekarang via WhatsApp (Respon 60 Menit)</span>
      </a>
    </div>
  </div>
</section>
