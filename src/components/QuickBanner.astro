---
import { siteConfig, orderingSteps } from '../config/site';
---

<section id="cara-order" class="relative py-16 sm:py-24 lg:py-28 bg-slate-50 dark:bg-[#040E1B] border-b border-slate-200/70 dark:border-navy-900 overflow-hidden section-content-visibility">
  <span id="form-booking" class="sr-only"></span>
  
  <!-- Subtle Blueprint Square Grid Background -->
  <div class="absolute inset-0 pointer-events-none select-none overflow-hidden" aria-hidden="true">
    <div class="w-full h-full bg-grid-blueprint dark:bg-grid-blueprint-dark [mask-image:radial-gradient(ellipse_75%_65%_at_50%_50%,black_35%,transparent_100%)]"></div>
  </div>

  <div class="relative z-10 max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Wide Gray/Tinted Rounded Banner -->
    <div class="bg-white dark:bg-[#071322]/90 rounded-3xl p-6 sm:p-10 lg:p-12 border border-slate-200/90 dark:border-navy-800/80 shadow-xs reveal-on-scroll relative overflow-hidden">
      
      <!-- Branded Logo Silhouette Watermark (Banner Background Identity) -->
      <div class="absolute -bottom-16 -right-16 sm:-bottom-20 sm:-right-20 pointer-events-none select-none z-0 overflow-hidden" aria-hidden="true">
        <!-- Light Mode: Navy Watermark -->
        <img
          src="/images/logo-navy.webp"
          alt=""
          class="w-64 h-64 sm:w-80 sm:h-80 lg:w-[420px] lg:h-[420px] object-contain opacity-[0.08] dark:hidden transform rotate-12"
          loading="lazy"
          decoding="async"
          width="420"
          height="420"
        />
        <!-- Dark Mode: White Watermark -->
        <img
          src="/images/logo-white.webp"
          alt=""
          class="hidden dark:block w-64 h-64 sm:w-80 sm:h-80 lg:w-[420px] lg:h-[420px] object-contain opacity-[0.14] mix-blend-screen transform rotate-12"
          loading="lazy"
          decoding="async"
          width="420"
          height="420"
        />
      </div>

      <!-- Top Pill & Headings -->
      <div class="relative z-10 text-center max-w-3xl mx-auto mb-10 sm:mb-12">
        <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-slate-100 dark:bg-navy-900 border border-slate-200 dark:border-navy-700 text-xs font-semibold text-navy-950 dark:text-iceblue-300 mb-3 shadow-2xs">
          <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
          <span data-i18n="order.badge">Alur Pemesanan Cepat & Booking via WhatsApp</span>
        </div>

        <h2 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-navy-950 dark:text-white tracking-tight mb-2.5" data-i18n="order.title">
          3 Langkah Praktis Memanggil Teknisi Jawara Teknik
        </h2>

        <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 leading-relaxed max-w-2xl mx-auto hidden sm:block" data-i18n="order.desc">
          Tanpa perlu unduh aplikasi atau registrasi rumit. Pilih jadwal dan isi data di bawah ini untuk terhubung langsung dengan teknisi siaga kami via WhatsApp.
        </p>
      </div>

      <!-- Integrated 3-Step Practical Stepper with Enlarged Badges & Scroll Slide-Up -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-5 sm:gap-6 lg:gap-8 mb-10 sm:mb-12 max-w-4xl mx-auto">
        {orderingSteps.map((item, index) => (
          <div
            class="step-reveal-card bg-slate-50/80 dark:bg-navy-950/70 hover:bg-white dark:hover:bg-navy-900/90 rounded-2xl p-6 sm:p-7 border border-slate-200/90 dark:border-navy-800/80 shadow-2xs flex flex-col justify-between group hover:border-iceblue-400 dark:hover:border-iceblue-400 hover:shadow-md transition-all duration-300"
            style={`transition-delay: ${index * 130}ms;`}
          >
            <div>
              <div class="flex items-center justify-between mb-4">
                <span class="text-3xl sm:text-4xl font-black text-navy-950 dark:text-white group-hover:text-iceblue-600 dark:group-hover:text-iceblue-400 transition-colors tracking-tighter select-none font-sans">
                  {item.step}
                </span>
                <span class="text-xs font-bold px-3 py-1 rounded-full bg-white dark:bg-navy-900 text-navy-900 dark:text-slate-200 border border-slate-200/80 dark:border-navy-700 shadow-2xs" data-i18n={`order.step${index + 1}_badge`}>
                  {index === 0 && 'Langkah 1'}
                  {index === 1 && 'Langkah 2'}
                  {index === 2 && 'Langkah 3'}
                </span>
              </div>
              <h3 class="font-extrabold text-base sm:text-lg text-navy-950 dark:text-white group-hover:text-iceblue-700 dark:group-hover:text-iceblue-300 transition-colors leading-snug my-2" data-i18n={`order.step${index + 1}_title`}>
                {item.title}
              </h3>
            </div>
            <div class="mt-4 pt-3 border-t border-slate-200/70 dark:border-navy-800 flex items-center justify-between text-xs sm:text-sm text-iceblue-700 dark:text-iceblue-400 font-extrabold">
              <span data-i18n={`order.step${index + 1}_action`}>{item.actionText}</span>
              <svg class="w-4 h-4 text-iceblue-600 dark:text-iceblue-400 group-hover:translate-x-1.5 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="m9 18 6-6-6-6"></path>
              </svg>
            </div>
          </div>
        ))}
      </div>

      <!-- 5-Field Quick Template WhatsApp Form Card -->
      <div class="bg-white dark:bg-navy-950/90 p-6 sm:p-8 rounded-2xl border border-slate-200/90 dark:border-navy-800/80 shadow-sm max-w-3xl mx-auto">
        <form id="quick-wa-template-form" class="space-y-4">
          
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <!-- Field 1: Nama Pemesan -->
            <div>
              <label for="quick-name" class="block text-xs font-bold text-navy-950 dark:text-slate-200 mb-1.5" data-i18n="form.label_name">
                Nama Pemesan <span class="text-rose-500">*</span>
              </label>
              <input
                type="text"
                id="quick-name"
                required
                placeholder="Ketik nama Anda (contoh: Budi / Wayan)"
                data-i18n-ph="form.ph_name"
                class="w-full px-3.5 py-2.5 text-xs sm:text-sm bg-slate-50 dark:bg-navy-900 border border-slate-300 dark:border-navy-700 rounded-lg focus:bg-white dark:focus:bg-navy-900 focus:outline-hidden focus:ring-2 focus:ring-iceblue-500 text-navy-950 dark:text-white font-medium transition-all"
              />
            </div>

            <!-- Field 2: Area / Lokasi di Bali -->
            <div>
              <label for="quick-area" class="block text-xs font-bold text-navy-950 dark:text-slate-200 mb-1.5" data-i18n="form.label_area">
                Area / Lokasi di Bali <span class="text-rose-500">*</span>
              </label>
              <select
                id="quick-area"
                required
                class="w-full px-3.5 py-2.5 text-xs sm:text-sm bg-slate-50 dark:bg-navy-900 border border-slate-300 dark:border-navy-700 rounded-lg focus:bg-white dark:focus:bg-navy-900 focus:outline-hidden focus:ring-2 focus:ring-iceblue-500 text-navy-950 dark:text-white font-medium transition-all"
              >
                <option value="" disabled selected data-i18n="form.opt_area_default">Pilih Area di Bali</option>
                <option value="Canggu (Badung)">Canggu (Badung)</option>
                <option value="Seminyak / Kerobokan">Seminyak / Kerobokan</option>
                <option value="Denpasar Barat">Denpasar Barat</option>
                <option value="Denpasar Selatan">Denpasar Selatan</option>
                <option value="Denpasar Timur">Denpasar Timur</option>
                <option value="Denpasar Utara">Denpasar Utara</option>
                <option value="Sanur">Sanur</option>
                <option value="Kuta / Legian / Tuban">Kuta / Legian / Tuban</option>
                <option value="Jimbaran / Nusa Dua">Jimbaran / Nusa Dua</option>
                <option value="Uluwatu / Pecatu">Uluwatu / Pecatu</option>
                <option value="Ubud (Gianyar)">Ubud (Gianyar)</option>
                <option value="Gianyar Kota">Gianyar Kota</option>
                <option value="Tabanan">Tabanan</option>
                <option value="Area Bali Lainnya" data-i18n="form.opt_area_other">Area Bali Lainnya</option>
              </select>
            </div>
          </div>

          <!-- Field 3: Jenis Layanan AC -->
          <div>
            <label for="quick-service" class="block text-xs font-bold text-navy-950 dark:text-slate-200 mb-1.5" data-i18n="form.label_service">
              Layanan yang Dibutuhkan <span class="text-rose-500">*</span>
            </label>
            <select
              id="quick-service"
              required
              class="w-full px-3.5 py-2.5 text-xs sm:text-sm bg-slate-50 dark:bg-navy-900 border border-slate-300 dark:border-navy-700 rounded-lg focus:bg-white dark:focus:bg-navy-900 focus:outline-hidden focus:ring-2 focus:ring-iceblue-500 text-navy-950 dark:text-white font-medium transition-all"
            >
              <option value="Cuci AC Standar (0.5 – 1 PK)" data-i18n="form.opt_srv_cuci1">Cuci AC Standar (0.5 – 1 PK)</option>
              <option value="Cuci AC Standar (1.5 – 2 PK)" data-i18n="form.opt_srv_cuci2">Cuci AC Standar (1.5 – 2 PK)</option>
              <option value="Cuci Unit AC Inverter Khusus" data-i18n="form.opt_srv_inverter">Cuci Unit AC Inverter Khusus</option>
              <option value="Tambah / Isi Freon R32 & R410a" data-i18n="form.opt_srv_freon">Tambah / Isi Freon R32 & R410a</option>
              <option value="Perbaikan AC Bocor / Menetes" data-i18n="form.opt_srv_leak">Perbaikan AC Bocor / Menetes</option>
              <option value="Jasa Pasang AC (0.5 – 2 PK)" data-i18n="form.opt_srv_install">Jasa Pasang AC (0.5 – 2 PK)</option>
              <option value="Bongkar AC / Bongkar + Pasang" data-i18n="form.opt_srv_dismantle">Bongkar AC / Bongkar + Pasang</option>
              <option value="Cuci Besar / Overhaul (Turun Unit)" data-i18n="form.opt_srv_overhaul">Cuci Besar / Overhaul (Turun Unit)</option>
              <option value="Pengecekan Kendala / Konsultasi Lainnya" data-i18n="form.opt_srv_other">Pengecekan Kendala / Konsultasi Lainnya</option>
            </select>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <!-- Field 4: Jumlah Unit -->
            <div>
              <label for="quick-units" class="block text-xs font-bold text-navy-950 dark:text-slate-200 mb-1.5" data-i18n="form.label_units">
                Jumlah Unit AC
              </label>
              <select
                id="quick-units"
                class="w-full px-3.5 py-2.5 text-xs sm:text-sm bg-slate-50 dark:bg-navy-900 border border-slate-300 dark:border-navy-700 rounded-lg focus:bg-white dark:focus:bg-navy-900 focus:outline-hidden focus:ring-2 focus:ring-iceblue-500 text-navy-950 dark:text-white font-medium transition-all"
              >
                <option value="1" data-i18n="form.opt_units_1">1 Unit</option>
                <option value="2" data-i18n="form.opt_units_2">2 Unit</option>
                <option value="3" data-i18n="form.opt_units_3">3 Unit</option>
                <option value="4" data-i18n="form.opt_units_4">4 Unit</option>
                <option value="5+ Unit (Proyek Villa / Usaha)" data-i18n="form.opt_units_5">5+ Unit (Proyek Villa / Usaha)</option>
              </select>
            </div>

            <!-- Field 5: Waktu Kunjungan -->
            <div>
              <label for="quick-time" class="block text-xs font-bold text-navy-950 dark:text-slate-200 mb-1.5" data-i18n="form.label_time">
                Pilihan Waktu Kunjungan
              </label>
              <select
                id="quick-time"
                class="w-full px-3.5 py-2.5 text-xs sm:text-sm bg-slate-50 dark:bg-navy-900 border border-slate-300 dark:border-navy-700 rounded-lg focus:bg-white dark:focus:bg-navy-900 focus:outline-hidden focus:ring-2 focus:ring-iceblue-500 text-navy-950 dark:text-white font-medium transition-all"
              >
                <option value="Hari Ini (Secepatnya / Emergency)" data-i18n="form.opt_time_today">Hari Ini (Secepatnya / Emergency)</option>
                <option value="Besok Pagi (08:00 – 12:00)" data-i18n="form.opt_time_morn">Besok Pagi (08:00 – 12:00)</option>
                <option value="Besok Siang (13:00 – 17:00)" data-i18n="form.opt_time_noon">Besok Siang (13:00 – 17:00)</option>
                <option value="Besok Sore / Malam (17:00 – 21:00)" data-i18n="form.opt_time_eve">Besok Sore / Malam (17:00 – 21:00)</option>
                <option value="Jadwal Khusus / Reservasi Nanti" data-i18n="form.opt_time_custom">Jadwal Khusus / Reservasi Nanti</option>
              </select>
            </div>
          </div>

          <!-- Submit CTA Button -->
          <div class="pt-2">
            <button
              type="submit"
              class="w-full inline-flex items-center justify-center gap-2.5 bg-navy-950 hover:bg-navy-900 dark:bg-iceblue-500 dark:hover:bg-iceblue-400 dark:text-navy-950 active:bg-black text-white font-bold text-xs sm:text-sm py-3.5 px-6 rounded-xl shadow-md transition-all duration-200 cursor-pointer group"
            >
              <!-- Lucide MessageCircle -->
              <svg class="w-4 h-4 text-emerald-400 dark:text-navy-950" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"></path>
              </svg>
              <span data-i18n="form.btn_submit">Kirim Jadwal via WhatsApp</span>
              <!-- Lucide ArrowRight -->
              <svg class="w-4 h-4 text-slate-300 dark:text-navy-900 group-hover:text-white dark:group-hover:text-navy-950 group-hover:translate-x-1 transition-all" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M5 12h14"></path>
                <path d="m12 5 7 7-7 7"></path>
              </svg>
            </button>
          </div>

        </form>
      </div>

      <!-- Trust Assurance Footnote -->
      <div class="flex flex-wrap items-center justify-center gap-y-1 gap-x-4 text-xs text-slate-500 dark:text-slate-400 mt-6">
        <span data-i18n="form.trust1">✓ Garansi 30 Hari Penuh</span>
        <span>•</span>
        <span data-i18n="form.trust2">✓ Tiba Dalam 60 Menit</span>
        <span>•</span>
        <span data-i18n="form.trust3">✓ Tarif Transparan di Awal</span>
      </div>

    </div>

  </div>
</section>

<!-- Interactive Quick WA Form Script -->
<script is:inline define:vars={{ phoneRaw: siteConfig.phoneRaw }}>
  document.addEventListener('DOMContentLoaded', () => {
    const form = document.getElementById('quick-wa-template-form');
    const nameInput = document.getElementById('quick-name');
    const areaSelect = document.getElementById('quick-area');
    const serviceSelect = document.getElementById('quick-service');
    const unitsSelect = document.getElementById('quick-units');
    const timeSelect = document.getElementById('quick-time');

    if (form) {
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        const lang = localStorage.getItem('jawara_lang') || 'id';
        const nameVal = nameInput ? nameInput.value.trim() : '';
        const areaVal = areaSelect ? areaSelect.value : '';
        const serviceVal = serviceSelect ? serviceSelect.value : '';
        const unitsVal = unitsSelect ? unitsSelect.value : '1';
        const timeVal = timeSelect ? timeSelect.value : '';

        let message = '';
        if (lang === 'en') {
          message = `Hello Admin Jawara Teknik Bali, I would like to schedule an AC service appointment:\n\n• Name: ${nameVal}\n• Area / Location: ${areaVal}\n• Service: ${serviceVal}\n• Quantity: ${unitsVal} Unit(s)\n• Preferred Schedule: ${timeVal}`;
        } else {
          message = `Halo Admin Jawara Teknik Bali, saya ingin jadwalkan servis AC:\n\n• Nama: ${nameVal}\n• Lokasi / Area: ${areaVal}\n• Layanan: ${serviceVal}\n• Jumlah: ${unitsVal} Unit\n• Waktu Kunjungan: ${timeVal}`;
        }

        const url = `https://wa.me/${phoneRaw}?text=${encodeURIComponent(message)}`;
        window.open(url, '_blank', 'noopener,noreferrer');
      });
    }

    // Scroll reveal observer for 3-step cards
    const stepCards = document.querySelectorAll('.step-reveal-card');
    if (stepCards.length > 0) {
      const stepObserver = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-revealed');
            stepObserver.unobserve(entry.target);
          }
        });
      }, { threshold: 0.15 });

      stepCards.forEach((c) => stepObserver.observe(c));
    }
  });
</script>

<style>
  .step-reveal-card {
    opacity: 0;
    transform: translateY(28px);
    transition: opacity 0.65s cubic-bezier(0.16, 1, 0.3, 1), transform 0.65s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.25s ease, border-color 0.25s ease;
    will-change: opacity, transform;
  }
  .step-reveal-card.is-revealed {
    opacity: 1;
    transform: translateY(0);
  }
  @media (prefers-reduced-motion: reduce) {
    .step-reveal-card {
      opacity: 1 !important;
      transform: none !important;
      transition: none !important;
    }
  }
</style>
