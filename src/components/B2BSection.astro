---
import { createWhatsAppLink } from '../config/site';

const villaB2BWaUrl = createWhatsAppLink({
  service: "Paket Kontrak Pemeliharaan Rutin Villa / Bisnis",
  notes: "Mohon penawaran harga khusus paket villa / kafe / guest house (invoice resmi)",
});
---

<section id="paket-villa" class="py-16 sm:py-24 bg-slatewhite border-b border-slate-200/70">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="relative bg-navy-950 rounded-3xl overflow-hidden shadow-lg border border-navy-800">
      
      <!-- Ambient Image Backdrop (Luxury Bali Villa - Clearly Visible) -->
      <div class="absolute inset-0 z-0">
        <img
          src="https://images.unsplash.com/photo-1580587771525-78b9dba3b914?auto=format&fit=crop&w=1400&q=80"
          alt="Luxury Bali Private Villa dengan pendingin ruangan prima"
          class="w-full h-full object-cover object-center opacity-30 filter brightness-90 contrast-105"
          loading="lazy"
          decoding="async"
        />
        <div class="absolute inset-0 bg-gradient-to-r from-navy-950 via-navy-950/90 to-navy-900/85"></div>
      </div>

      <div class="relative z-10 p-8 sm:p-12 lg:p-16">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
          
          <!-- Content Column -->
          <div class="lg:col-span-7">
            <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full glass-ios-pill text-iceblue-300 text-xs font-semibold mb-5">
              <!-- Lucide Building2 -->
              <svg class="w-3.5 h-3.5 text-iceblue-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M6 22V4a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v18Z"></path>
                <path d="M6 12H4a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2h2"></path>
                <path d="M18 9h2a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2h-2"></path>
                <path d="M10 6h4"></path>
                <path d="M10 10h4"></path>
                <path d="M10 14h4"></path>
                <path d="M10 18h4"></path>
              </svg>
              <span>Solusi Komersial B2B Bali</span>
            </div>

            <h2 class="text-2xl sm:text-4xl font-extrabold text-white tracking-tight leading-snug mb-4">
              Paket Pemeliharaan Rutin untuk Villa, Kafe, & Homestay
            </h2>

            <p class="text-base sm:text-lg text-slate-300 font-normal leading-relaxed mb-8">
              Mencegah komplain wisatawan dan kerusakan mendadak. Layanan kontrak berkala 2-3 bulan sekali, prioritas panggilan darurat, dan invoice resmi.
            </p>

            <!-- Key Benefit Points (Official Lucide SVG Icons) -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-8">
              <div class="glass-ios-dark p-4 rounded-xl border border-white/10 flex items-start gap-3">
                <div class="w-8 h-8 rounded-lg bg-emerald-500/20 text-emerald-400 flex items-center justify-center shrink-0 mt-0.5">
                  <!-- Lucide Zap -->
                  <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
                  </svg>
                </div>
                <div>
                  <h3 class="font-bold text-sm text-white">Prioritas Tamu Villa</h3>
                  <p class="text-xs text-slate-400">Respon kilat saat tamu mengeluhkan pendingin ruangan.</p>
                </div>
              </div>

              <div class="glass-ios-dark p-4 rounded-xl border border-white/10 flex items-start gap-3">
                <div class="w-8 h-8 rounded-lg bg-emerald-500/20 text-emerald-400 flex items-center justify-center shrink-0 mt-0.5">
                  <!-- Lucide FileText -->
                  <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"></path>
                    <polyline points="14 2 14 8 20 8"></polyline>
                    <line x1="16" x2="8" y1="13" y2="13"></line>
                    <line x1="16" x2="8" y1="17" y2="17"></line>
                    <line x1="10" x2="8" y1="9" y2="9"></line>
                  </svg>
                </div>
                <div>
                  <h3 class="font-bold text-sm text-white">Invoice Resmi & Rekap</h3>
                  <p class="text-xs text-slate-400">Bukti kerja terlampir rapi untuk pembukuan akuntansi.</p>
                </div>
              </div>

              <div class="glass-ios-dark p-4 rounded-xl border border-white/10 flex items-start gap-3">
                <div class="w-8 h-8 rounded-lg bg-emerald-500/20 text-emerald-400 flex items-center justify-center shrink-0 mt-0.5">
                  <!-- Lucide Sparkles -->
                  <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"></path>
                    <path d="M5 3v4"></path>
                    <path d="M19 17v4"></path>
                    <path d="M3 5h4"></path>
                    <path d="M17 19h4"></path>
                  </svg>
                </div>
                <div>
                  <h3 class="font-bold text-sm text-white">Teknisi Rapi & Ramah</h3>
                  <p class="text-xs text-slate-400">Seragam bersih & terpal proteksi lantai interior villa.</p>
                </div>
              </div>

              <div class="glass-ios-dark p-4 rounded-xl border border-white/10 flex items-start gap-3">
                <div class="w-8 h-8 rounded-lg bg-emerald-500/20 text-emerald-400 flex items-center justify-center shrink-0 mt-0.5">
                  <!-- Lucide Percent -->
                  <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="19" x2="5" y1="5" y2="19"></line>
                    <circle cx="6.5" cy="6.5" r="2.5"></circle>
                    <circle cx="17.5" cy="17.5" r="2.5"></circle>
                  </svg>
                </div>
                <div>
                  <h3 class="font-bold text-sm text-white">Diskon Volume Kontrak</h3>
                  <p class="text-xs text-slate-400">Tarif khusus untuk pemeliharaan rutin 5 hingga 50+ unit.</p>
                </div>
              </div>
            </div>

            <!-- CTA Button -->
            <div>
              <a
                href={villaB2BWaUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center justify-center gap-3 btn-cta-whatsapp text-slate-950 font-bold text-base px-8 py-4 rounded-2xl"
              >
                <!-- WhatsApp Icon -->
                <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
                  <path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2zm.01 1.67c4.54 0 8.24 3.7 8.24 8.24 0 2.2-.86 4.27-2.42 5.82a8.19 8.19 0 0 1-5.82 2.42c-1.48 0-2.93-.4-4.2-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.2 8.2 0 0 1-1.26-4.38c0-4.54 3.7-8.24 8.24-8.24zm4.5 11.66c-.25-.13-1.47-.72-1.7-.81-.23-.08-.39-.13-.56.13-.17.25-.64.81-.79.97-.14.17-.29.19-.54.06-.25-.13-1.07-.39-2.03-1.25-.75-.67-1.26-1.5-1.4-1.75-.15-.25-.02-.39.11-.51.11-.11.25-.29.38-.44.12-.14.17-.25.25-.42.08-.17.04-.31-.02-.44-.06-.13-.56-1.35-.77-1.85-.2-.49-.41-.42-.56-.43l-.48-.01c-.17 0-.44.06-.67.31-.23.25-.88.86-.88 2.1 0 1.24.9 2.44 1.03 2.61.13.17 1.78 2.71 4.3 3.8 2.52 1.09 2.52.73 2.98.69.45-.05 1.47-.6 1.68-1.18.21-.58.21-1.08.15-1.18-.06-.11-.23-.17-.48-.29z"/>
                </svg>
                <span>Konsultasi Paket Villa</span>
              </a>
            </div>
          </div>

          <!-- Right Column: Visual Metrics in Frosted Glass -->
          <div class="lg:col-span-5">
            <div class="glass-ios-dark rounded-2xl p-7 border border-white/10">
              <h3 class="text-xs font-bold uppercase tracking-wider text-iceblue-300 mb-6 flex items-center gap-2">
                <span class="w-2 h-2 rounded-full bg-iceblue-400"></span>
                Tingkat Kepuasan Mitra Properti Bali
              </h3>

              <div class="space-y-5">
                <div>
                  <div class="flex justify-between text-xs font-semibold mb-1.5">
                    <span class="text-slate-300">Ketepatan Waktu Kunjungan</span>
                    <span class="text-emerald-400 font-bold">99.2%</span>
                  </div>
                  <div class="w-full h-1.5 bg-white/10 rounded-full overflow-hidden">
                    <div class="h-full bg-emerald-400 rounded-full" style="width: 99.2%"></div>
                  </div>
                </div>

                <div>
                  <div class="flex justify-between text-xs font-semibold mb-1.5">
                    <span class="text-slate-300">Penurunan Komplain AC Tamu</span>
                    <span class="text-emerald-400 font-bold">100%</span>
                  </div>
                  <div class="w-full h-1.5 bg-white/10 rounded-full overflow-hidden">
                    <div class="h-full bg-emerald-400 rounded-full" style="width: 100%"></div>
                  </div>
                </div>

                <div>
                  <div class="flex justify-between text-xs font-semibold mb-1.5">
                    <span class="text-slate-300">Efisiensi Konsumsi Listrik AC</span>
                    <span class="text-iceblue-300 font-bold">Hingga 25%</span>
                  </div>
                  <div class="w-full h-1.5 bg-white/10 rounded-full overflow-hidden">
                    <div class="h-full bg-iceblue-400 rounded-full" style="width: 85%"></div>
                  </div>
                </div>
              </div>

              <div class="mt-8 pt-6 border-t border-white/10 flex items-center gap-4">
                <div class="flex -space-x-2 overflow-hidden">
                  <span class="inline-block h-8 w-8 rounded-full ring-2 ring-navy-950 bg-iceblue-600 text-center leading-8 text-[10px] font-bold text-white">VL</span>
                  <span class="inline-block h-8 w-8 rounded-full ring-2 ring-navy-950 bg-emerald-600 text-center leading-8 text-[10px] font-bold text-white">KF</span>
                  <span class="inline-block h-8 w-8 rounded-full ring-2 ring-navy-950 bg-amber-600 text-center leading-8 text-[10px] font-bold text-white">GH</span>
                </div>
                <p class="text-xs text-slate-300 leading-relaxed">
                  Dipercaya <strong>45+ villa & kafe</strong> di Canggu, Seminyak, Sanur & Ubud.
                </p>
              </div>
            </div>
          </div>

        </div>
      </div>
    </div>
  </div>
</section>
