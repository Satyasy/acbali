---
import { siteConfig, coverageAreas, createWhatsAppLink } from '../config/site';
---

<section id="wilayah" class="py-16 sm:py-24 bg-white border-b border-slate-200/60">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="max-w-3xl mx-auto text-center mb-12 sm:mb-16">
      <div class="inline-flex items-center gap-1.5 px-3.5 py-1 rounded-full bg-iceblue-50 text-iceblue-700 text-xs font-semibold mb-3 border border-iceblue-200">
        <!-- Lucide MapPin -->
        <svg class="w-3.5 h-3.5 text-iceblue-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
        </svg>
        <span>Cakupan Teknisi Siaga di Bali</span>
      </div>
      <h2 class="text-2xl sm:text-4xl font-extrabold text-navy-950 tracking-tight">
        Jangkauan Wilayah Layanan Panggilan Teknisi di Bali
      </h2>
      <p class="mt-3.5 text-base text-slate-600">
        Teknisi kami tersebar di pos-pos strategis untuk memastikan estimasi tiba tercepat ke lokasi Anda.
      </p>
    </div>

    <!-- Regions Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 mb-12">
      {coverageAreas.map((area) => (
        <article class="bg-slatewhite rounded-2xl p-6 sm:p-7 border border-slate-200/90 hover:border-iceblue-400 transition-all duration-300 shadow-sm glass-bubble-hover flex flex-col justify-between">
          <div>
            <!-- Region Header -->
            <div class="flex items-center justify-between gap-2 mb-5 pb-4 border-b border-slate-200/70">
              <div class="flex items-center gap-2.5">
                <div class="w-9 h-9 rounded-xl bg-navy-800 text-white flex items-center justify-center font-bold shadow-sm">
                  <!-- Lucide MapPin -->
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                  </svg>
                </div>
                <h3 class="font-extrabold text-lg text-navy-950">{area.regency}</h3>
              </div>
              <span class="text-[11px] font-semibold px-2.5 py-0.5 rounded-full bg-iceblue-100 text-iceblue-800 border border-iceblue-200">
                {area.badge}
              </span>
            </div>

            <!-- District / Locality Chips -->
            <div class="space-y-4">
              {area.districts.map((district) => (
                <div>
                  <h4 class="text-xs font-bold text-navy-800 uppercase tracking-wider mb-2 flex items-center gap-1.5">
                    <span class="w-1.5 h-1.5 rounded-full bg-iceblue-600"></span>
                    {district.name}
                  </h4>
                  <div class="flex flex-wrap gap-1.5">
                    {district.sub.map((subArea) => (
                      <span class="text-xs px-2.5 py-1 rounded-lg bg-white text-slate-700 border border-slate-200 hover:bg-iceblue-50 hover:border-iceblue-300 transition-colors shadow-2xs">
                        {subArea}
                      </span>
                    ))}
                  </div>
                </div>
              ))}
            </div>
          </div>

          <!-- Quick Action per Region -->
          <div class="mt-6 pt-4 border-t border-slate-200/70">
            <a
              href={createWhatsAppLink({
                service: `Layanan Teknisi Wilayah ${area.regency}`,
                notes: `Saya berada di area ${area.regency}, apakah ada teknisi siaga saat ini?`,
              })}
              target="_blank"
              rel="noopener noreferrer"
              class="w-full inline-flex items-center justify-center gap-2 text-xs font-bold py-2.5 px-3 rounded-xl bg-white hover:bg-wagreen hover:text-slate-950 text-navy-900 border border-slate-200 shadow-2xs transition-colors"
            >
              <span>Cek Teknisi di {area.regency}</span>
              <span>&rarr;</span>
            </a>
          </div>
        </article>
      ))}
    </div>

    <!-- Area Note Banner & Google Maps Verified Profile -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 max-w-4xl mx-auto">
      <div class="bg-white rounded-2xl p-5 border border-slate-200/90 shadow-2xs flex items-center justify-between gap-4">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-xl bg-iceblue-50 text-iceblue-600 border border-iceblue-200/60 flex items-center justify-center shrink-0">
            <!-- Lucide MapPin -->
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"></path>
              <circle cx="12" cy="10" r="3"></circle>
            </svg>
          </div>
          <div>
            <h4 class="font-bold text-sm text-navy-950">Terdaftar di Google Maps</h4>
            <p class="text-xs text-slate-500">Service AC Panggilan Jawara Teknik</p>
          </div>
        </div>
        <a
          href={siteConfig.mapsDirectUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1 text-xs font-bold text-iceblue-600 hover:text-iceblue-700 underline shrink-0"
        >
          <span>Buka Maps</span>
          <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
            <polyline points="15 3 21 3 21 9"></polyline>
            <line x1="10" y1="14" x2="21" y2="3"></line>
          </svg>
        </a>
      </div>

      <div class="bg-white rounded-2xl p-5 border border-slate-200/90 shadow-2xs flex items-center justify-between gap-4">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-xl bg-emerald-50 text-emerald-600 border border-emerald-200/60 flex items-center justify-center shrink-0">
            <!-- Lucide Navigation -->
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polygon points="3 11 22 2 13 21 11 13 3 11"></polygon>
            </svg>
          </div>
          <div>
            <h4 class="font-bold text-sm text-navy-950">Area Anda Belum Ada?</h4>
            <p class="text-xs text-slate-500">Tetap melayani se-Bali sesuai jadwal</p>
          </div>
        </div>
        <a
          href={createWhatsAppLink({ service: "Cek Wilayah Khusus Bali" })}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1 text-xs font-bold text-emerald-600 hover:text-emerald-700 underline shrink-0"
        >
          <span>Tanya Admin</span>
          <span>&rarr;</span>
        </a>
      </div>
    </div>
  </div>
</section>
