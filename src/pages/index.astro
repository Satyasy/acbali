---
import Layout from '../layouts/Layout.astro';
import TopBar from '../components/TopBar.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import PainPoints from '../components/PainPoints.astro';
import Pricing from '../components/Pricing.astro';
import B2BSection from '../components/B2BSection.astro';
import CoverageAreas from '../components/CoverageAreas.astro';
import HowToOrder from '../components/HowToOrder.astro';
import QuickBanner from '../components/QuickBanner.astro';
import FAQSection from '../components/FAQSection.astro';
import Footer from '../components/Footer.astro';
import FloatingWhatsApp from '../components/FloatingWhatsApp.astro';
import { siteConfig } from '../config/site';
---

<Layout 
  title={`${siteConfig.legalName} - Jasa Servis & Cuci AC Panggilan Cepat di Bali (06.00 – 23.00 WITA)`}
  description={siteConfig.description}
>
  <!-- 1. Top Bar -->
  <TopBar />

  <!-- Main Navigation Bar -->
  <Navbar />

  <main>
    <!-- 2. Hero Section (Split 2-Column with Asymmetric Photo Mosaic matching sample/layout.png) -->
    <Hero />

    <!-- 3. Layanan Utama & Katalog Tarif dengan Filter Pills (matching 'Top Destinations') -->
    <Pricing />

    <!-- 4. Solusi Kendala AC (matching 'Latest Stories': 1 Featured + 3 Compact Horizontal) -->
    <PainPoints />

    <!-- 5. Posko Armada & Standar Operasional di Bali (matching 'Trekker Highlights' 3-Column) -->
    <CoverageAreas />

    <!-- 6. Pre-Footer Interactive Action Banner (matching 'Get Your Travel Inspiration') -->
    <QuickBanner />

    <!-- 7. How to Order (3 Simple Steps) -->
    <HowToOrder />

    <!-- 8. Additional FAQ Section for High SEO & Trust -->
    <FAQSection />
  </main>

  <!-- 9. Footer & NAP Integration -->
  <Footer />

  <!-- 8. Floating Sticky WhatsApp CTA (Mobile & Desktop) -->
  <FloatingWhatsApp />
</Layout>
