---
import Layout from '../layouts/Layout.astro';
import TopBar from '../components/TopBar.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import RunningBanner from '../components/RunningBanner.astro';
import PainPoints from '../components/PainPoints.astro';
import Pricing from '../components/Pricing.astro';
import B2BSection from '../components/B2BSection.astro';
import CoverageAreas from '../components/CoverageAreas.astro';
import QuickBanner from '../components/QuickBanner.astro';
import FAQSection from '../components/FAQSection.astro';
import Footer from '../components/Footer.astro';
import FloatingWhatsApp from '../components/FloatingWhatsApp.astro';
import BookingModal from '../components/BookingModal.astro';
import { siteConfig } from '../config/site';
---

<Layout 
  title={`${siteConfig.legalName} - Jasa Servis & Cuci AC Panggilan Cepat di Bali (24 Jam Non-Stop)`}
  description={siteConfig.description}
>
  <!-- 1. Top Bar -->
  <TopBar />

  <!-- Main Navigation Bar -->
  <Navbar />

  <main>
    <!-- 2. Hero Section -->
    <Hero />

    <!-- 2b. Running Marquee Banner (Apple Frosted Dark Navy) -->
    <RunningBanner />

    <!-- 3. Layanan Utama & Katalog Tarif dengan Filter Pills -->
    <Pricing />

    <!-- 4. Solusi Kendala AC -->
    <PainPoints />

    <!-- 5. Posko Armada & Standar Operasional di Bali -->
    <CoverageAreas />

    <!-- 6. Alur 3 Langkah Pemesanan & Formulir Booking Cepat Terpadu -->
    <QuickBanner />

    <!-- 7. FAQ Section for High SEO & Trust -->
    <FAQSection />
  </main>

  <!-- 9. Footer & NAP Integration -->
  <Footer />

  <!-- 8. Floating Sticky WhatsApp CTA (Mobile & Desktop) -->
  <FloatingWhatsApp />

  <!-- 10. Interactive Quick Booking Modal Popup -->
  <BookingModal />
</Layout>
